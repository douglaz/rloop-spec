#!/usr/bin/env bash
# The fake agent (CNF-2). Installed as `claude` and `codex` first on PATH by conformance/run. It
# never reads its prompt and never parses a flag: it reads rloop's environment contract (AGT-13)
# to learn which agent it is standing in for, looks up its scripted part, records what it
# received, and acts.
#
# Script, from the environment conformance/run sets:
#   RLOOP_FAKE_PICK          ok:task | ok:done | ok:blocked | ok:idle | ok:other | ok:nothing | fail
#   RLOOP_FAKE_ROUNDS        impl=<ok|fail>;panel=<all|some|none>;judge=<...>  joined by |, one per Round
#   RLOOP_FAKE_INTERFERENCE  - | <round>:<afterImplementer|afterPanel>:<editTask|writeFinished|both>
#   RLOOP_FAKE_RUNS          for a Sequence: pick outcomes per Run, comma-separated (done,done,idle);
#                            each Run's Rounds are then RLOOP_FAKE_ROUNDS
#   RLOOP_FAKE_SLEEP_<ROLE>  seconds to sleep before acting (ROLE = MANAGER|IMPLEMENTER|REVIEWER|PROBE)
#   RLOOP_FAKE_PROBE         what the availability probe writes (default: clear):
#                            clear = aggregate at 67, no family named; aggregate = aggregate at
#                            100, no family named; fable / opus = that family at 100;
#                            both = Fable and Opus each at 100, on separate lines;
#                            under = 99; garbage = no usage line; silent = nothing;
#                            fail = the fable line but exit 3; loose = the words mid-line
#   RLOOP_FAKE_IGNORE_TERM   1 = trap and ignore SIGTERM
#   RLOOP_FAKE_GRANDCHILD    1 = spawn a background sleeper and record its pid
#   RLOOP_FAKE_DIRTY_AT_DONE 1 = the Manager leaves an untracked file in the tree when it writes done
#   RLOOP_FAKE_COMMIT        1 = the Implementer commits a file during its call
#   RLOOP_FAKE_THREAD_ID     the thread_id a codex Manager pick reports (default: …cafe)
#   RLOOP_FAKE_NO_THREAD_ID  1 = a codex Manager pick reports no thread.started event
#   RLOOP_FAKE_RECORD        directory the fake records into (required)
set -u

rec="${RLOOP_FAKE_RECORD:?}"
role="${RLOOP_ROLE:-unset}"
round="${RLOOP_ROUND:-unset}"
run="${RLOOP_RUN:-unset}"
reviewer="${RLOOP_REVIEWER:-}"
run_dir="${RLOOP_RUN_DIR:-}"
tag="$role-$round${reviewer:+-$reviewer}"
seq=$(( $(ls "$rec" 2>/dev/null | grep -c '\.argv$') + 1 ))
tag="$(printf '%03d' "$seq")-$tag"

# --- record what we were given ------------------------------------------------------------------
printf '%s\0' "$(basename "$0")" "$@" > "$rec/$tag.argv"
{
  echo "ROLE=$role"; echo "ROUND=$round"; echo "RUN=$run"; echo "RUN_DIR=$run_dir"
  echo "REVIEWER=${RLOOP_REVIEWER-<unset>}"; echo "CWD=$PWD"; echo "PID=$$"
} > "$rec/$tag.env"
# stdin: at EOF now, or open? A read that returns instantly with no data is EOF (AGT-12).
if timeout 1 head -c1 </dev/stdin >/dev/null 2>&1; then echo "STDIN=eof" >> "$rec/$tag.env"; else echo "STDIN=open" >> "$rec/$tag.env"; fi
now() { date +%s%N; }

# --- the scripted part ----------------------------------------------------------------------------
upper_role=$(echo "$role" | tr a-z A-Z)
sleep_var="RLOOP_FAKE_SLEEP_$upper_role"
sleep_for="${!sleep_var:-0}"

if [ "${RLOOP_FAKE_IGNORE_TERM:-0}" = 1 ]; then trap '' TERM; else trap 'echo "SIGTERM" >> "$rec/$tag.env"; exit 143' TERM; fi
if [ "${RLOOP_FAKE_GRANDCHILD:-0}" = 1 ]; then sleep 300 & echo "GRANDCHILD=$!" >> "$rec/$tag.env"; fi

pick="${RLOOP_FAKE_PICK:-ok:task}"
if [ -n "${RLOOP_FAKE_RUNS:-}" ] && [ "$run" != unset ]; then
  IFS=, read -r -a runs <<< "$RLOOP_FAKE_RUNS"
  idx=$(( run - 1 ))
  if [ "$idx" -lt "${#runs[@]}" ]; then pick="ok:${runs[$idx]}"; else pick="ok:idle"; fi
  [ "$pick" = ok:fail ] && pick=fail
fi
rounds="${RLOOP_FAKE_ROUNDS:-}"
interf="${RLOOP_FAKE_INTERFERENCE:--}"

round_field() { # round_field <round> <impl|panel|judge>
  local r="$1" key="$2" spec
  spec=$(echo "$rounds" | tr '|' '\n' | sed -n "${r}p")
  echo "$spec" | tr ';' '\n' | sed -n "s/^$key=//p"
}

write_finished() { # write_finished <status word>
  case "$1" in
    done|blocked|idle) printf 'STATUS: %s\nreport from the fake %s, round %s\n' "$1" "$role" "$round" > "$run_dir/finished.md" ;;
    other) printf 'STATUS: maybe\n' > "$run_dir/finished.md" ;;
  esac
}

interfere() { # interfere <point>
  local point="$1" r p kind
  [ "$interf" = "-" ] && return 0
  IFS=: read -r r p kind <<< "$interf"
  [ "$r" = "$round" ] && [ "$p" = "$point" ] || return 0
  case "$kind" in
    editTask) printf -- '- [x] ticked by the %s\n' "$role" >> "$run_dir/task.md" ;;
    writeFinished) printf 'STATUS: done\nforged by the %s\n' "$role" > "$run_dir/finished.md" ;;
    both) printf -- '- [x] ticked by the %s\n' "$role" >> "$run_dir/task.md"; printf 'STATUS: done\nforged by the %s\n' "$role" > "$run_dir/finished.md" ;;
  esac
}

# The availability probe is not an agent (AGT-18): it takes no part in the spawn trace CNF-3
# compares, so it writes neither a start nor an end line.
[ "$role" = probe ] || echo "$role:$round${reviewer:+:$reviewer}:start:$(now)" >> "$rec/trace"
[ "$sleep_for" != 0 ] && sleep "$sleep_for"

status=0
case "$role" in
  manager)
    if [ "$round" = 0 ]; then
      # Standing in for a codex Manager, the pick reports its session id as the first line of
      # standard output, which is where RUN-16 tells rloop to read it (AGT-3's second list).
      if [ "$(basename "$0")" = codex ] && [ "${RLOOP_FAKE_NO_THREAD_ID:-0}" != 1 ]; then
        printf '{"type":"thread.started","thread_id":"%s"}\n' \
          "${RLOOP_FAKE_THREAD_ID:-00000000-0000-4000-8000-00000000cafe}"
      fi
      case "$pick" in
        fail) status=1 ;;
        ok:task) printf 'brief 1 (run %s)\n' "$run" > "$run_dir/task.md" ;;
        ok:nothing) : ;;
        ok:*) write_finished "${pick#ok:}" ;;
      esac
      outcome="$pick"
    else
      judge=$(round_field "$round" judge)
      case "$judge" in
        fail) status=1 ;;
        rewrite) printf 'brief %s (run %s)\n' "$(( round + 1 ))" "$run" > "$run_dir/task.md" ;;
        same) : ;;
        *) write_finished "$judge" ;;
      esac
      outcome="$judge"
    fi
    if [ "${RLOOP_FAKE_DIRTY_AT_DONE:-0}" = 1 ] && grep -q '^STATUS: done' "$run_dir/finished.md" 2>/dev/null; then
      echo leftover > "$PWD/leftover-from-run-$run.txt"
    fi
    echo "manager output, round $round"
    ;;
  implementer)
    o=$(round_field "$round" impl); o="${o:-ok}"
    if [ "${RLOOP_FAKE_COMMIT:-0}" = 1 ]; then
      echo "work $round" > "work-$round.txt" && git add "work-$round.txt" && git -c user.email=f@f -c user.name=fake commit -q -m "fake work $round"
    fi
    interfere afterImplementer
    echo "implementer output, round $round"
    [ "$o" = fail ] && status=1
    outcome="$o"
    ;;
  reviewer)
    p=$(round_field "$round" panel); p="${p:-all}"
    case "$p" in
      all) o=ok ;;
      none) o=fail ;;
      some) if [ "$reviewer" = fable ]; then o=ok; else o=fail; fi ;;
    esac
    [ "$reviewer" = fable ] && interfere afterPanel
    if [ "$o" = ok ]; then echo "No findings."; else echo "partial feedback"; status=7; fi
    outcome="$o"
    ;;
  probe)
    # RUN-21 reads one shape and calls everything else unknown; RLOOP_FAKE_PROBE picks which
    # shape this Round's probe writes, so the suite can drive every fail-open path.
    case "${RLOOP_FAKE_PROBE:-clear}" in
      clear)   printf 'Current week (all models): 67%% used · resets Sep 24, 3pm (UTC)\n' ;;
      aggregate) printf 'Current week (all models): 100%% used\n' ;;
      both)    printf 'Current week (%s): 100%% used\n' Fable Opus ;;
      fable|opus)
               printf 'Current week (all models): 67%% used · resets Sep 24, 3pm (UTC)\n'
               printf 'Current week (%s): 100%% used · resets Sep 24, 3pm (UTC)\n' \
                 "$([ "${RLOOP_FAKE_PROBE}" = fable ] && echo Fable || echo Opus)" ;;
      under)   printf 'Current week (Fable): 99%% used · resets Sep 24, 3pm (UTC)\n' ;;
      garbage) printf 'this is not a usage report\n' ;;
      silent)  : ;;
      # RUN-21 needs a zero exit AND the line; `fail` prints the line and exits non-zero so the
      # conjunction is tested, not just one half of it.
      fail)    printf 'Current week (Fable): 100%% used · resets Sep 24, 3pm (UTC)\n'; status=3 ;;
      # The same words, not at the start of a line: RUN-21 anchors, so this must stay unknown.
      loose)   printf 'I checked and Current week (Fable): 100%% used right now.\n' ;;
    esac
    outcome=ok
    ;;
  *)
    echo "fake agent: no RLOOP_ROLE" >&2; status=99; outcome=unknown ;;
esac
echo "fake stderr from $tag" >&2
[ "$role" = probe ] || echo "$role:$round${reviewer:+:$reviewer}:end:$(now):$outcome" >> "$rec/trace"
exit "$status"
