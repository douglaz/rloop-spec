#!/usr/bin/env bash
# The Conformance Suite (06-conformance.md): conformance/run <rloop executable> [--self-check]
#
# Runs every CNF item against the executable with fake agents first on PATH, prints one line per
# item, exits 0 only if all passed. Needs bash, git, GNU coreutils, grep, sed, awk, cmp and find;
# nothing else. The executable sees the fakes, the tools CNF-1 names for an Implementation, and
# the git shim for the CNF-19 items — see CNF-2; restrict_path in scenario-lib.sh builds it.
set -u

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
spec="$(dirname "$here")"
exe="${1:?usage: conformance/run <rloop executable> [--self-check]}"
exe="$(cd "$(dirname "$exe")" && pwd)/$(basename "$exe")"
[ -x "$exe" ] || { echo "not executable: $exe" >&2; exit 2; }
self_check=0; [ "${2:-}" = "--self-check" ] && self_check=1

work="$(mktemp -d "${TMPDIR:-/tmp}/rloop-conformance.XXXXXX")"
trap 'rm -rf "$work"' EXIT
fakes="$work/fakes"; mkdir -p "$fakes"
cp "$here/fakes/agent" "$fakes/claude"; cp "$here/fakes/agent" "$fakes/codex"; chmod +x "$fakes/claude" "$fakes/codex"
real_git="$(command -v git)"

pass=0; fail=0; failed_items=()
verdict() { # verdict <CNF id> <ok|fail> <detail>
  if [ "$2" = ok ]; then pass=$((pass + 1)); printf '  PASS  %s  %s\n' "$1" "$3"
  else fail=$((fail + 1)); failed_items+=("$1"); printf '  FAIL  %s  %s\n' "$1" "$3"; fi
}
export -n RLOOP_FAKE_PICK RLOOP_FAKE_ROUNDS RLOOP_FAKE_INTERFERENCE RLOOP_FAKE_RUNS RLOOP_FAKE_THREAD_ID RLOOP_FAKE_NO_THREAD_ID RLOOP_FAKE_PROBE_PICK 2>/dev/null || true

source "$here/scenario-lib.sh"
restrict_path
spawn_count() { ls "$1"/*.argv 2>/dev/null | wc -l | tr -d ' '; }
# Both Seats on a model RUN-21's table does not name, so that no verdict of theirs stops the Run.
off=(--manager-model "$off_table_model" --implementer-model "$off_table_model")
# record_is <record file> <label> <verdict of each Seat, in RUN-21's order>: byte for byte, every line
# ending with a newline, the last included; command substitution could see neither a missing
# newline nor an extra blank line.
record_is() {
  local f="$1" label="$2"; shift 2
  printf 'manager:%s\nimplementer:%s\nfable:%s\nopus:%s\nastra:%s\nsol:%s\n' "$@" | cmp -s - "$f" \
    || { ok=0; detail="$detail [$label: $(basename "$f") is not ${*// /,}: '$(tr '\n' ' ' 2>/dev/null < "$f")']"; }
}
scenarios_file="$spec/conformance/scenarios.tsv"

echo "rloop conformance suite against $exe"
echo
read -r bad total <<< "$(run_scenarios "$scenarios_file" | tail -1)"
if [ "$bad" = 0 ]; then verdict CNF-3 ok "$total scenarios replayed"; else verdict CNF-3 fail "$bad of $total scenarios differ"; fi

if [ "$self_check" = 1 ]; then
  flipped="$work/flipped.tsv"
  awk -F'\t' 'BEGIN{OFS="\t"} NR==2{$8=($8=="0")?"2":"0"} {print}' "$scenarios_file" > "$flipped"
  read -r bad2 _ <<< "$(run_scenarios "$flipped" | tail -1)"
  if [ "$bad2" -ge 1 ]; then verdict CNF-4 ok "a flipped expectation made the suite red"; else verdict CNF-4 fail "the suite stayed green over a flipped expectation"; fi
else
  verdict CNF-4 ok "(run with --self-check to exercise)"
fi

# --- CNF-5: usage errors -----------------------------------------------------------------------------
repo="$(new_repo)"; ok=1; detail=""
# One call per row, the row as its argument array: a string split on whitespace could not carry
# the empty --run-dir value, and a word-split '' arrives as two quote characters.
usage_error() { # usage_error <rloop arguments...>: exit 2, nothing spawned, standard error written
  local rec="$work/rec-usage" e; rm -rf "$rec"
  e=$(run_rloop "$repo" "$rec" "$@")
  if [ "$e" != 2 ] || [ "$(spawn_count "$rec")" != 0 ] || [ ! -s "$rec/stderr" ]; then ok=0; detail="$detail [$(printf '%q ' "$@")-> exit $e, $(spawn_count "$rec") spawns]"; fi
}
usage_error --bogus
usage_error --max-rounds 0
usage_error --max-rounds x
usage_error --reviewer-timeout -1
usage_error --reviewer-timeout 0
usage_error --probe-timeout 0
usage_error --kill-after 0
usage_error a b
usage_error --auto --base HEAD
usage_error --auto --run-dir "$repo/d"
usage_error --auto --run-dir ''
usage_error --implementer-model --max-rounds 1
usage_error --=x
usage_error --auto=1
usage_error --help=x
usage_error --version=x
usage_error --manager gpt-6-astra
for args in "--version" "--help"; do
  rec="$work/rec-usage"; rm -rf "$rec"
  # shellcheck disable=SC2086
  e=$(run_rloop "$repo" "$rec" $args)
  if [ "$e" != 0 ] || [ "$(spawn_count "$rec")" != 0 ]; then ok=0; detail="$detail [$args -> exit $e]"; fi
done
# --max-runs 08 is eight: one pick when the first goes idle, eight when every pick ends done.
rec="$work/rec-usage"; rm -rf "$rec"
e=$(RLOOP_FAKE_RUNS=idle run_rloop "$repo" "$rec" --auto --max-runs 08)
picks=$(ls "$rec"/*-manager-0.argv 2>/dev/null | wc -l | tr -d ' ')
[ "$e" = 0 ] && [ "$picks" = 1 ] || { ok=0; detail="$detail [--auto --max-runs 08, idle -> exit $e, $picks picks]"; }
rec="$work/rec-usage"; rm -rf "$rec"
e=$(RLOOP_FAKE_RUNS="done,done,done,done,done,done,done,done,done" run_rloop "$repo" "$rec" --auto --max-runs 08)
picks=$(ls "$rec"/*-manager-0.argv 2>/dev/null | wc -l | tr -d ' ')
[ "$e" = 2 ] && [ "$picks" = 8 ] || { ok=0; detail="$detail [--auto --max-runs 08, nine done -> exit $e, $picks picks]"; }
if [ "$ok" = 1 ]; then verdict CNF-5 ok "usage errors exit 2 and spawn nothing; --version/--help exit 0; --max-runs 08 is eight"; else verdict CNF-5 fail "$detail"; fi

# --- CNF-6: outside git -----------------------------------------------------------------------------
notgit="$(mktemp -d "$work/notgit.XXXXXX")"; rec="$work/rec-notgit"
e=$(run_rloop "$notgit" "$rec" --run-dir "$notgit/run")
if [ "$e" = 2 ] && [ "$(spawn_count "$rec")" = 0 ]; then verdict CNF-6 ok "exit 2, nothing spawned"; else verdict CNF-6 fail "exit $e, $(spawn_count "$rec") spawns"; fi

# --- CNF-7: the run directory must not exist --------------------------------------------------------
repo="$(new_repo)"; ok=1; detail=""
mkdir -p "$repo/existing" "$repo/nonempty"; echo x > "$repo/nonempty/finished.md"
for d in "$repo/existing" "$repo/nonempty" "$repo/no/such/parent/run"; do
  rec="$work/rec-dir"; rm -rf "$rec"
  e=$(run_rloop "$repo" "$rec" --run-dir "$d")
  if [ "$e" != 2 ] || [ "$(spawn_count "$rec")" != 0 ]; then ok=0; detail="$detail [$d -> exit $e]"; fi
done
rec="$work/rec-dir"; rm -rf "$rec"
before=$(find "$repo" -mindepth 1 -type d -not -path '*/.git*' | sort)
e=$(RLOOP_FAKE_PICK=ok:done run_rloop "$repo" "$rec" --run-dir "$repo/fresh")
after=$(find "$repo" -mindepth 1 -type d -not -path '*/.git*' -not -path "$repo/fresh*" | sort)
if [ ! -d "$repo/fresh" ] || [ "$before" != "$after" ]; then ok=0; detail="$detail [fresh: exit $e, dir $([ -d "$repo/fresh" ] && echo present || echo missing)]"; fi
if [ "$ok" = 1 ]; then verdict CNF-7 ok "existing or parentless run dir refused; fresh one created"; else verdict CNF-7 fail "$detail"; fi

# --- CNF-8: the default run directory ---------------------------------------------------------------
repo="$(new_repo)"; rec="$work/rec-default"
e=$(RLOOP_FAKE_PICK=ok:task RLOOP_FAKE_ROUNDS="impl=ok;panel=all;judge=done" run_rloop "$repo" "$rec")
rd=$(ls -d "$repo"/.rloop/runs/*/ 2>/dev/null | head -1)
status_out=$(cd "$repo" && git status --porcelain)
ok=1; detail=""
if [ "$e" = 0 ] && [ -n "$rd" ] && printf '*\n' | cmp -s - "$repo/.rloop/.gitignore" && [ -z "$status_out" ]; then :
else ok=0; detail="$detail [fresh: exit $e, run dir '$rd', gitignore '$(od -An -c "$repo/.rloop/.gitignore" 2>/dev/null | tr -s ' ')', status '$status_out']"; fi
# DIR-2 states bytes: a pre-existing file a check by eye accepts — `*` and two newlines, or `*`
# and no newline — is rewritten to exactly `*` and a newline.
for shape in 'two newlines:*\n\n' 'no newline:*'; do
  label="${shape%%:*}"; repo="$(new_repo)"; rec="$work/rec-default-$label"
  mkdir -p "$repo/.rloop" && printf "${shape#*:}" > "$repo/.rloop/.gitignore"
  e=$(RLOOP_FAKE_PICK=ok:task RLOOP_FAKE_ROUNDS="impl=ok;panel=all;judge=done" run_rloop "$repo" "$rec")
  status_out=$(cd "$repo" && git status --porcelain)
  if [ "$e" = 0 ] && printf '*\n' | cmp -s - "$repo/.rloop/.gitignore" && [ -z "$status_out" ]; then :
  else ok=0; detail="$detail [$label: exit $e, gitignore '$(od -An -c "$repo/.rloop/.gitignore" 2>/dev/null | tr -s ' ')', status '$status_out']"; fi
done
if [ "$ok" = 1 ]; then verdict CNF-8 ok ".rloop/runs/<id>/ created, self-ignored byte for byte (a pre-existing by-eye .gitignore rewritten), tree clean"
else verdict CNF-8 fail "$detail"; fi

# --- CNF-9: the layout --------------------------------------------------------------------------------
repo="$(new_repo)"; rec="$work/rec-layout"
e=$(RLOOP_FAKE_PICK=ok:task RLOOP_FAKE_ROUNDS="impl=ok;panel=all;judge=rewrite|impl=ok;panel=all;judge=done" run_rloop "$repo" "$rec" --run-dir "$repo/run")
expected_names="feedback-1-astra.md feedback-1-fable.md feedback-1-opus.md feedback-1-sol.md feedback-2-astra.md feedback-2-fable.md feedback-2-opus.md feedback-2-sol.md finished.md implementer-1.err implementer-1.out implementer-2.err implementer-2.out manager-judge-1.err manager-judge-1.out manager-judge-2.err manager-judge-2.out manager-pick.err manager-pick.out probe-1.err probe-1.md probe-1.out probe-2.err probe-2.md probe-2.out probe-pick.err probe-pick.md probe-pick.out reviewer-1-astra.err reviewer-1-fable.err reviewer-1-opus.err reviewer-1-sol.err reviewer-2-astra.err reviewer-2-fable.err reviewer-2-opus.err reviewer-2-sol.err session task-1.md task-2.md task.md"
got_names=$(ls "$repo/run" | sort | tr '\n' ' ' | sed 's/ $//')
ok=1; detail=""
[ "$e" = 0 ] || { ok=0; detail="exit $e"; }
[ "$got_names" = "$expected_names" ] || { ok=0; detail="$detail names: $got_names"; }
[ "$(cat "$repo/run/implementer-1.out")" = "implementer output, round 1" ] || { ok=0; detail="$detail implementer-1.out"; }
grep -q "fake stderr from" "$repo/run/implementer-1.err" || { ok=0; detail="$detail implementer-1.err"; }
[ "$(cat "$repo/run/feedback-1-opus.md")" = "No findings." ] || { ok=0; detail="$detail feedback-1-opus.md"; }
sid=$(cat "$repo/run/session"); [[ "$sid" =~ ^[0-9a-fA-F-]{36}$ ]] || { ok=0; detail="$detail session '$sid'"; }
# a Run that ends 2 keeps its directory; a missing snapshot is exit 2 (DIR-8, from the excuse table)
repo2="$(new_repo)"; rec2="$work/rec-layout2"
e2=$(RLOOP_FAKE_PICK=ok:task RLOOP_FAKE_ROUNDS="impl=ok;panel=none;judge=done" run_rloop "$repo2" "$rec2" --run-dir "$repo2/run")
[ "$e2" = 2 ] && [ -f "$repo2/run/task-1.md" ] || { ok=0; detail="$detail (exit-2 run dir: exit $e2)"; }
if [ "$ok" = 1 ]; then verdict CNF-9 ok "exactly DIR-4's names; outputs captured entire; session is a UUID; kept on exit 2"; else verdict CNF-9 fail "$detail"; fi

# --- CNF-10: the environment contract ---------------------------------------------------------------
ok=1; detail=""
check_env() { # check_env <env file> <ROLE> <ROUND> <REVIEWER or <unset>>
  local f="$1"
  grep -qx "ROLE=$2" "$f" || { ok=0; detail="$detail [$(basename "$f"): ROLE]"; }
  grep -qx "ROUND=$3" "$f" || { ok=0; detail="$detail [$(basename "$f"): ROUND]"; }
  grep -qx "RUN=1" "$f" || { ok=0; detail="$detail [$(basename "$f"): RUN]"; }
  grep -qx "RUN_DIR=$repo/run" "$f" || { ok=0; detail="$detail [$(basename "$f"): RUN_DIR]"; }
  grep -qx "REVIEWER=$4" "$f" || { ok=0; detail="$detail [$(basename "$f"): REVIEWER]"; }
  grep -qx "CWD=$repo" "$f" || { ok=0; detail="$detail [$(basename "$f"): CWD]"; }
  grep -qx "STDIN=eof" "$f" || { ok=0; detail="$detail [$(basename "$f"): STDIN]"; }
}
check_env "$(ls "$rec"/*-manager-0.env)" manager 0 "<unset>"
check_env "$(ls "$rec"/*-implementer-1.env)" implementer 1 "<unset>"
check_env "$(ls "$rec"/*-manager-1.env)" manager 1 "<unset>"
for r in fable opus astra sol; do check_env "$(ls "$rec"/*-reviewer-2-$r.env)" reviewer 2 "$r"; done
if [ "$ok" = 1 ]; then verdict CNF-10 ok "RLOOP_* variables, cwd and closed stdin for every role"; else verdict CNF-10 fail "$detail"; fi

# --- CNF-11 / CNF-12: argv and prompts ---------------------------------------------------------------
render() { # render <template file> ; placeholders from variables P_*, one pass by PRM-6
  # The template is walked once, {{NAME}} by {{NAME}}; a value is appended and never looked at
  # again, so placeholder text and any byte inside it survive. A name PRM-6 does not list stays.
  local t out="" name v; t="$(cat "$1")"
  while [[ $t == *\{\{*\}\}* ]]; do
    out+="${t%%\{\{*}"; t="${t#*\{\{}"; name="${t%%\}\}*}"; t="${t#*\}\}}"
    case $name in
      INSTRUCTION|TASK_FILE|FINISHED_FILE|RUN_DIR|BASE|ROUND|MAX_ROUNDS|IMPLEMENTER_LOG|FEEDBACK_FILES|DIRTY_AT_START|UNAVAILABLE)
        v="P_$name"; out+="${!v}" ;;
      *) out+="{{$name}}" ;;
    esac
  done
  printf '%s' "$out$t"
}
expected_argv() { # expected_argv <argv fixture> <prompt text> <session> <model> -> NUL-joined; one model per fixture
  local line
  while IFS= read -r line; do
    case "$line" in
      "<pick prompt>"|"<judge prompt>"|"<implementer prompt>"|"<review prompt>") printf '%s\0' "$2" ;;
      "<session id>") printf '%s\0' "$3" ;;
      "<manager model>"|"<implementer model>") printf '%s\0' "$4" ;;
      *) printf '%s\0' "$line" ;;
    esac
  done < "$1"
}
argv_matches() { # argv_matches <recorded .argv> <expected NUL file>
  cmp -s "$1" "$2"
}
fx="$spec/conformance/fixtures"
repo="$(new_repo)"; rec="$work/rec-argv"
echo changed >> "$repo/README"; echo new > "$repo/untracked.txt"
base_hash=$(cd "$repo" && git rev-parse HEAD)
e=$(RLOOP_FAKE_PICK=ok:task RLOOP_FAKE_ROUNDS="impl=ok;panel=all;judge=done" run_rloop "$repo" "$rec" --run-dir "$repo/run" --max-rounds 7 "please do the thing")
sid=$(cat "$repo/run/session" 2>/dev/null)
P_INSTRUCTION="please do the thing"; P_TASK_FILE="$repo/run/task.md"; P_FINISHED_FILE="$repo/run/finished.md"; P_RUN_DIR="$repo/run"
P_BASE="$base_hash"; P_ROUND=1; P_MAX_ROUNDS=7; P_IMPLEMENTER_LOG="$repo/run/implementer-1.out"
P_FEEDBACK_FILES="$repo/run/feedback-1-fable.md
$repo/run/feedback-1-opus.md
$repo/run/feedback-1-astra.md
$repo/run/feedback-1-sol.md"
P_DIRTY_AT_START=" M README
?? untracked.txt"
P_UNAVAILABLE=""
ok=1; detail=""; prompt_ok=1; prompt_detail=""
[ "$e" = 0 ] || { ok=0; detail="$detail [run 1: exit $e]"; }
check_call() { # check_call <recorded glob> <argv fixture> <prompt fixture> <session> <model> <label>
  local recf prompt arg seen=0; recf=$(ls $1 2>/dev/null | head -1)
  [ -n "$recf" ] || { ok=0; detail="$detail [$6: not spawned]"; prompt_ok=0; prompt_detail="$prompt_detail [$6: not spawned]"; return; }
  prompt="$(render "$3")"
  expected_argv "$2" "$prompt" "$4" "$5" > "$work/expected.argv"
  argv_matches "$recf" "$work/expected.argv" || { ok=0; detail="$detail [$6: argv differs]"; }
  # CNF-12 reads the prompt argument alone; where it sits among the others is CNF-11's
  while IFS= read -r -d '' arg; do [ "$arg" = "$prompt" ] && seen=1; done < "$recf"
  [ "$seen" = 1 ] || { prompt_ok=0; prompt_detail="$prompt_detail [$6: prompt differs]"; }
}
check_call "$rec/*-manager-0.argv" "$fx/argv/AGT-3-1.txt" "$fx/prompts/PRM-1.txt" "$sid" claude-fable-5-1 pick
check_call "$rec/*-implementer-1.argv" "$fx/argv/AGT-5.txt" "$fx/prompts/PRM-3.txt" "$sid" claude-fable-5-1 implementer
check_call "$rec/*-reviewer-1-fable.argv" "$fx/argv/AGT-7.txt" "$fx/prompts/PRM-4.txt" "$sid" x fable
check_call "$rec/*-reviewer-1-opus.argv" "$fx/argv/AGT-8.txt" "$fx/prompts/PRM-4.txt" "$sid" x opus
check_call "$rec/*-reviewer-1-astra.argv" "$fx/argv/AGT-10-1.txt" "$fx/prompts/PRM-4.txt" "$sid" x astra
check_call "$rec/*-reviewer-1-sol.argv" "$fx/argv/AGT-10-2.txt" "$fx/prompts/PRM-4.txt" "$sid" x sol
check_call "$rec/*-manager-1.argv" "$fx/argv/AGT-4-1.txt" "$fx/prompts/PRM-2.txt" "$sid" claude-fable-5-1 judge
argv_ok=$ok; argv_detail="$detail"
# a second Run: clean tree, no instruction, codex implementer, another manager model
repo="$(new_repo)"; rec="$work/rec-argv2"
base_hash=$(cd "$repo" && git rev-parse HEAD)
e=$(RLOOP_FAKE_PICK=ok:task RLOOP_FAKE_ROUNDS="impl=ok;panel=all;judge=done" run_rloop "$repo" "$rec" --run-dir "$repo/run" --implementer codex --manager-model claude-opus-5)
sid=$(cat "$repo/run/session" 2>/dev/null)
P_INSTRUCTION=""; P_TASK_FILE="$repo/run/task.md"; P_FINISHED_FILE="$repo/run/finished.md"; P_RUN_DIR="$repo/run"; P_BASE="$base_hash"
P_MAX_ROUNDS=10; P_IMPLEMENTER_LOG="$repo/run/implementer-1.out"; P_DIRTY_AT_START=""; P_UNAVAILABLE=""
P_FEEDBACK_FILES="$repo/run/feedback-1-fable.md
$repo/run/feedback-1-opus.md
$repo/run/feedback-1-astra.md
$repo/run/feedback-1-sol.md"
ok=1; detail=""
[ "$e" = 0 ] || { ok=0; detail="$detail [run 2 (codex implementer): exit $e]"; }
check_call "$rec/*-manager-0.argv" "$fx/argv/AGT-3-1.txt" "$fx/prompts/PRM-1.txt" "$sid" claude-opus-5 "pick (clean, no instruction)"
check_call "$rec/*-implementer-1.argv" "$fx/argv/AGT-6.txt" "$fx/prompts/PRM-3.txt" "$sid" gpt-6-astra "codex implementer"
check_call "$rec/*-manager-1.argv" "$fx/argv/AGT-4-1.txt" "$fx/prompts/PRM-2.txt" "$sid" claude-opus-5 "judge (clean)"
argv2_ok=$ok; argv2_detail="$detail"
# a third Run: the codex Manager preset, at its default model, resuming the id the pick reported,
# over two Rounds (Round 1 sends the brief back, Round 2 finishes) so that CNF-23 reads more than
# one judge call. CNF-11 below reads Round 1's records; Round 2's are its own and read by CNF-23
repo="$(new_repo)"; rec="$work/rec-argv3"
base_hash=$(cd "$repo" && git rev-parse HEAD)
e=$(RLOOP_FAKE_PICK=ok:task RLOOP_FAKE_ROUNDS="impl=ok;panel=all;judge=rewrite|impl=ok;panel=all;judge=done" run_rloop "$repo" "$rec" --run-dir "$repo/run" --manager codex)
e_codex=$e; repo_codex="$repo"
sid=$(cat "$repo/run/session" 2>/dev/null)
P_TASK_FILE="$repo/run/task.md"; P_FINISHED_FILE="$repo/run/finished.md"; P_RUN_DIR="$repo/run"; P_BASE="$base_hash"
P_IMPLEMENTER_LOG="$repo/run/implementer-1.out"; P_UNAVAILABLE=""
P_FEEDBACK_FILES="$repo/run/feedback-1-fable.md
$repo/run/feedback-1-opus.md
$repo/run/feedback-1-astra.md
$repo/run/feedback-1-sol.md"
ok=1; detail=""
check_call "$rec/*-manager-0.argv" "$fx/argv/AGT-3-2.txt" "$fx/prompts/PRM-1.txt" "$sid" gpt-6-astra "codex pick"
check_call "$rec/*-manager-1.argv" "$fx/argv/AGT-4-2.txt" "$fx/prompts/PRM-2.txt" "$sid" gpt-6-astra "codex judge"
argv3_ok=$ok; argv3_detail="$detail"
# a hostile Run: the instruction holds placeholder names and bytes a rescanning or unquoted
# substitution would change, and the Run Directory path holds {{INSTRUCTION}} (the cyclic case);
# PRM-6 renders each once, byte for byte. The fake reads no prompt; the instruction reaches it
# through rloop's argv alone, so no knob is needed. The instruction reaches the pick's prompt alone
# (PRM-2 carries no {{INSTRUCTION}}); the judge check exercises the cyclic Run Directory path only.
repo="$(new_repo)"; rec_h="$work/rec-argv-hostile"  # its own rec and sid: CNF-23 reads the third Run's
base_hash=$(cd "$repo" && git rev-parse HEAD)
P_INSTRUCTION='Repair literal {{TASK_FILE}} and {{UNAVAILABLE}} tokens; keep \ & %s and {{ROUND}} as written'
P_RUN_DIR="$repo/{{INSTRUCTION}}"
e=$(RLOOP_FAKE_PICK=ok:task RLOOP_FAKE_ROUNDS="impl=ok;panel=all;judge=done" run_rloop "$repo" "$rec_h" --run-dir "$P_RUN_DIR" "$P_INSTRUCTION")
sid_h=$(cat "$P_RUN_DIR/session" 2>/dev/null)
P_TASK_FILE="$P_RUN_DIR/task.md"; P_FINISHED_FILE="$P_RUN_DIR/finished.md"; P_BASE="$base_hash"
P_ROUND=1; P_MAX_ROUNDS=10; P_IMPLEMENTER_LOG="$P_RUN_DIR/implementer-1.out"; P_DIRTY_AT_START=""; P_UNAVAILABLE=""
P_FEEDBACK_FILES="$P_RUN_DIR/feedback-1-fable.md
$P_RUN_DIR/feedback-1-opus.md
$P_RUN_DIR/feedback-1-astra.md
$P_RUN_DIR/feedback-1-sol.md"
ok=1; detail=""
[ "$e" = 0 ] || { ok=0; detail="$detail [hostile: exit $e]"; }
check_call "$rec_h/*-manager-0.argv" "$fx/argv/AGT-3-1.txt" "$fx/prompts/PRM-1.txt" "$sid_h" claude-fable-5-1 "pick (hostile instruction, cyclic run dir)"
check_call "$rec_h/*-implementer-1.argv" "$fx/argv/AGT-5.txt" "$fx/prompts/PRM-3.txt" "$sid_h" claude-fable-5-1 "implementer (cyclic run dir)"
check_call "$rec_h/*-manager-1.argv" "$fx/argv/AGT-4-1.txt" "$fx/prompts/PRM-2.txt" "$sid_h" claude-fable-5-1 "judge (cyclic run dir)"
argv_hostile_ok=$ok; argv_hostile_detail="$detail"
# a fourth Run: the Implementer on a model no Seat defaults to ($off_table_model, scenario-lib.sh); every Seat is asserted, so a flag that moved
# the Manager's model (the claude preset's default here) or any Reviewer's fixed one is caught. Without the
# flag an Implementation spawns nothing here (AGT-2), failing CNF-11 and CNF-12, whose snapshot follows this Run
repo="$(new_repo)"; rec4="$work/rec-argv4"
base_hash=$(cd "$repo" && git rev-parse HEAD)
e=$(RLOOP_FAKE_PICK=ok:task RLOOP_FAKE_ROUNDS="impl=ok;panel=all;judge=done" run_rloop "$repo" "$rec4" --run-dir "$repo/run" --implementer-model "$off_table_model")
sid4=$(cat "$repo/run/session" 2>/dev/null)  # its own record directory and sid: CNF-23 reads the third Run's
P_INSTRUCTION=""; P_TASK_FILE="$repo/run/task.md"; P_FINISHED_FILE="$repo/run/finished.md"; P_RUN_DIR="$repo/run"; P_BASE="$base_hash"
P_ROUND=1; P_MAX_ROUNDS=10; P_IMPLEMENTER_LOG="$repo/run/implementer-1.out"; P_DIRTY_AT_START=""; P_UNAVAILABLE=""
P_FEEDBACK_FILES="$repo/run/feedback-1-fable.md
$repo/run/feedback-1-opus.md
$repo/run/feedback-1-astra.md
$repo/run/feedback-1-sol.md"
ok=1; detail=""
[ "$e" = 0 ] || { ok=0; detail="$detail [--implementer-model $off_table_model: exit $e]"; }
check_call "$rec4/*-manager-0.argv" "$fx/argv/AGT-3-1.txt" "$fx/prompts/PRM-1.txt" "$sid4" claude-fable-5-1 "pick (--implementer-model $off_table_model)"
check_call "$rec4/*-implementer-1.argv" "$fx/argv/AGT-5.txt" "$fx/prompts/PRM-3.txt" x "$off_table_model" "implementer (--implementer-model $off_table_model)"
check_call "$rec4/*-reviewer-1-fable.argv" "$fx/argv/AGT-7.txt" "$fx/prompts/PRM-4.txt" "$sid4" x "fable (--implementer-model $off_table_model)"
check_call "$rec4/*-reviewer-1-opus.argv" "$fx/argv/AGT-8.txt" "$fx/prompts/PRM-4.txt" "$sid4" x "opus (--implementer-model $off_table_model)"
check_call "$rec4/*-reviewer-1-astra.argv" "$fx/argv/AGT-10-1.txt" "$fx/prompts/PRM-4.txt" "$sid4" x "astra (--implementer-model $off_table_model)"
check_call "$rec4/*-reviewer-1-sol.argv" "$fx/argv/AGT-10-2.txt" "$fx/prompts/PRM-4.txt" "$sid4" x "sol (--implementer-model $off_table_model)"
check_call "$rec4/*-manager-1.argv" "$fx/argv/AGT-4-1.txt" "$fx/prompts/PRM-2.txt" "$sid4" claude-fable-5-1 "judge (--implementer-model $off_table_model)"
prompts_ok=$prompt_ok; prompts_detail="$prompt_detail"
if [ "$argv_ok" = 1 ] && [ "$argv2_ok" = 1 ] && [ "$argv3_ok" = 1 ] && [ "$argv_hostile_ok" = 1 ] && [ "$ok" = 1 ]; then verdict CNF-11 ok "every role's argv is its fixture with the placeholders filled, under both presets of the Manager and the Implementer, and a model given to each"; else verdict CNF-11 fail "$argv_detail $argv2_detail $argv3_detail $argv_hostile_detail $detail"; fi
if [ "$prompts_ok" = 1 ]; then verdict CNF-12 ok "every prompt is its fixture rendered in one pass; placeholder names, backslash, & and %s in an instruction and {{INSTRUCTION}} in the Run Directory path survive"; else verdict CNF-12 fail "$prompts_detail"; fi

# --- CNF-23: the codex Manager's session id ------------------------------------------------------------
ok=1; detail=""
[ "$e_codex" = 0 ] || { ok=0; detail="$detail [the codex Manager Run exited $e_codex, not 0]"; }
grep -q '^STATUS: done' "$repo_codex/run/finished.md" 2>/dev/null || { ok=0; detail="$detail [the codex Manager Run left no done Finished File]"; }
[ "$sid" = "00000000-0000-4000-8000-00000000cafe" ] || { ok=0; detail="$detail [session '$sid' is not the reported thread_id]"; }
# every judge call, not the first one: round 0 is the pick, which reports the id rather than
# carrying it, so the glob starts at 1. A record that fails names itself
judges=0
for f in "$rec"/*-manager-[1-9]*.argv; do
  [ -e "$f" ] || continue
  judges=$(( judges + 1 ))
  tr '\0' '\n' < "$f" | grep -qx -- "$sid" || { ok=0; detail="$detail [judge call $(basename "$f") does not carry the id]"; }
done
if [ "$judges" = 0 ]; then ok=0; detail="$detail [no judge argv recorded]"
elif [ "$judges" != 2 ]; then ok=0; detail="$detail [judge argv records: $judges, not the two this Run's two Rounds make]"; fi
printf '{"type":"thread.started","thread_id":"%s"}\nmanager output, round 0\n' "$sid" > "$work/expected-pick.out"
cmp -s "$repo_codex/run/manager-pick.out" "$work/expected-pick.out" || { ok=0; detail="$detail [manager-pick.out is not the pick's output entire]"; }
repo="$(new_repo)"; rec="$work/rec-nothread"
e=$(RLOOP_FAKE_PICK=ok:task RLOOP_FAKE_NO_THREAD_ID=1 run_rloop "$repo" "$rec" --run-dir "$repo/run" --manager codex)
[ "$e" = 2 ] || { ok=0; detail="$detail [a pick reporting no id exited $e]"; }
ls "$rec"/*-implementer-*.argv >/dev/null 2>&1 && { ok=0; detail="$detail [a Round ran after a pick reporting no id]"; }
[ -d "$repo/run" ] || { ok=0; detail="$detail [the Run Directory was not kept]"; }
if [ "$ok" = 1 ]; then verdict CNF-23 ok "a codex Manager Run of two Rounds ends 0 done; the session file holds the reported thread_id, every judge call carries it, the pick's output is kept entire, and a pick reporting none exits 2"; else verdict CNF-23 fail "$detail"; fi

# --- CNF-13: the base ---------------------------------------------------------------------------------
repo="$(new_repo)"; rec="$work/rec-base"
( cd "$repo" && echo two > two && git add two && git -c user.email=s@s -c user.name=suite commit -q -m two && git tag older HEAD~1 )
older_hash=$(cd "$repo" && git rev-parse older)
e=$(RLOOP_FAKE_PICK=ok:task RLOOP_FAKE_ROUNDS="impl=ok;panel=all;judge=rewrite|impl=ok;panel=all;judge=done" RLOOP_FAKE_COMMIT=1 run_rloop "$repo" "$rec" --run-dir "$repo/run" --base older)
ok=1; detail=""
for f in $(ls "$rec"/*-reviewer-1-fable.argv "$rec"/*-reviewer-2-fable.argv "$rec"/*-manager-2.argv 2>/dev/null); do
  tr '\0' '\n' < "$f" | grep -q "since commit $older_hash" || { ok=0; detail="$detail [$(basename "$f") lacks $older_hash]"; }
done
[ "$e" = 0 ] || { ok=0; detail="$detail exit $e"; }
if [ "$ok" = 1 ]; then verdict CNF-13 ok "--base ref rendered as its hash and stable across Rounds"; else verdict CNF-13 fail "$detail"; fi

# --- CNF-14: stdout ------------------------------------------------------------------------------------
ok=1; detail=""
for st in done blocked idle; do
  repo="$(new_repo)"; rec="$work/rec-out-$st"
  e=$(RLOOP_FAKE_PICK="ok:$st" run_rloop "$repo" "$rec" --run-dir "$repo/run")
  cmp -s "$rec/stdout" "$repo/run/finished.md" || { ok=0; detail="$detail [$st: stdout is not finished.md]"; }
done
repo="$(new_repo)"; rec="$work/rec-out-2"
e=$(RLOOP_FAKE_PICK=fail run_rloop "$repo" "$rec" --run-dir "$repo/run")
[ "$e" = 2 ] && [ ! -s "$rec/stdout" ] && [ -s "$rec/stderr" ] || { ok=0; detail="$detail [exit-2 stdout/stderr]"; }
# Exit 2 with a Finished File on disk (RUN-11): a pick whose first line is not a status, and a
# judge that wrote STATUS: idle after a Round. Neither reaches standard output.
repo="$(new_repo)"; rec="$work/rec-out-2-other"
e=$(RLOOP_FAKE_PICK=ok:other run_rloop "$repo" "$rec" --run-dir "$repo/run")
[ "$e" = 2 ] && [ ! -s "$rec/stdout" ] && [ -s "$rec/stderr" ] && [ -f "$repo/run/finished.md" ] || { ok=0; detail="$detail [ok:other: exit $e, stdout/stderr/finished.md]"; }
# A first line of `STATUS: do`, NUL, `ne`: RUN-9 compares byte for byte, and a reader that drops
# NUL bytes sees `done` and exits 0. The byte count of the raw first line is what such a reader
# gets wrong: 14 (`STATUS: done` is 12, the NUL 13, the newline 14).
repo="$(new_repo)"; rec="$work/rec-out-2-nul"
e=$(RLOOP_FAKE_PICK=ok:nul run_rloop "$repo" "$rec" --run-dir "$repo/run")
[ "$e" = 2 ] && [ ! -s "$rec/stdout" ] && [ -s "$rec/stderr" ] && [ -f "$repo/run/finished.md" ] || { ok=0; detail="$detail [ok:nul: exit $e, stdout/stderr/finished.md]"; }
[ "$(head -n1 "$repo/run/finished.md" 2>/dev/null | wc -c | tr -d ' ')" = 14 ] || { ok=0; detail="$detail [ok:nul: first line is not 14 bytes]"; }
repo="$(new_repo)"; rec="$work/rec-out-2-idle-judge"
e=$(RLOOP_FAKE_PICK=ok:task RLOOP_FAKE_ROUNDS="impl=ok;panel=all;judge=idle" run_rloop "$repo" "$rec" --run-dir "$repo/run")
[ "$e" = 2 ] && [ ! -s "$rec/stdout" ] && [ -s "$rec/stderr" ] && [ -f "$repo/run/finished.md" ] || { ok=0; detail="$detail [judge=idle: exit $e, stdout/stderr/finished.md]"; }
if [ "$ok" = 1 ]; then verdict CNF-14 ok "stdout is the Finished File on 0/1/3, empty on 2 with or without a Finished File"; else verdict CNF-14 fail "$detail"; fi

# --- CNF-15: reviewer failure note --------------------------------------------------------------------
repo="$(new_repo)"; rec="$work/rec-revfail"
e=$(RLOOP_FAKE_PICK=ok:task RLOOP_FAKE_ROUNDS="impl=ok;panel=some;judge=done" run_rloop "$repo" "$rec" --run-dir "$repo/run")
want=$'partial feedback\nREVIEWER FAILED (exit 7)'
got=$(cat "$repo/run/feedback-1-opus.md" 2>/dev/null)
if [ "$e" = 0 ] && [ "$got" = "$want" ] && [ "$(cat "$repo/run/feedback-1-fable.md")" = "No findings." ]; then verdict CNF-15 ok "failure note appended, Round proceeded"; else verdict CNF-15 fail "exit $e; feedback-1-opus.md: '$got'"; fi

# --- CNF-16: the Panel runs concurrently -------------------------------------------------------------
repo="$(new_repo)"; rec="$work/rec-conc"
t0=$(date +%s)
e=$(RLOOP_FAKE_PICK=ok:task RLOOP_FAKE_ROUNDS="impl=ok;panel=all;judge=done" RLOOP_FAKE_SLEEP_REVIEWER=2 run_rloop "$repo" "$rec" --run-dir "$repo/run")
t1=$(date +%s)
last_start=$(grep '^reviewer:1:.*:start:' "$rec/trace" | awk -F: '{print $5}' | sort -n | tail -1)
first_end=$(grep '^reviewer:1:.*:end:' "$rec/trace" | awk -F: '{print $5}' | sort -n | head -1)
if [ "$e" = 0 ] && [ $((t1 - t0)) -lt 8 ] && [ "$last_start" -lt "$first_end" ]; then verdict CNF-16 ok "four 2-second Reviewers overlapped"; else verdict CNF-16 fail "exit $e, $((t1 - t0))s, last start $last_start first end $first_end"; fi

# --- CNF-17: timeouts and process groups -------------------------------------------------------------
ok=1; detail=""
# pid_in <pid> <space-separated pids>: exact match, not a substring
pid_in() { tr ' ' '\n' <<< "$2" | grep -qx "$1"; }
# kill_recorded <record dir>: SIGKILL every PID and GRANDCHILD a fake recorded, so a red row leaves nothing behind
kill_recorded() { local f p; for f in "$1"/*.env; do for p in $(sed -n 's/^\(PID\|GRANDCHILD\)=//p' "$f" 2>/dev/null); do kill -9 "$p" 2>/dev/null; done; done; }
# One Reviewer sleeps and spawns a child that ignores SIGTERM; the other three answer, so the judge
# is called. The judge's own record says which children were alive when it started (AGT-14, AGT-16).
repo="$(new_repo)"; rec="$work/rec-tmo"
e=$(RLOOP_FAKE_PICK=ok:task RLOOP_FAKE_ROUNDS="impl=ok;panel=all;judge=done" RLOOP_FAKE_SLEEP_REVIEWER=30 RLOOP_FAKE_SLEEP_ONLY=fable RLOOP_FAKE_GRANDCHILD_IGNORE_TERM=1 run_rloop "$repo" "$rec" --run-dir "$repo/run" --reviewer-timeout 1 --kill-after 1)
[ "$e" = 0 ] || { ok=0; detail="$detail [one reviewer timed out: exit $e]"; }
grep -q 'REVIEWER FAILED' "$repo/run/feedback-1-fable.md" 2>/dev/null || { ok=0; detail="$detail [no failure note after reviewer timeout]"; }
for r in opus astra sol; do [ "$(cat "$repo/run/feedback-1-$r.md" 2>/dev/null)" = "No findings." ] || { ok=0; detail="$detail [$r did not answer]"; }; done
grep -q '^manager:1:start:' "$rec/trace" 2>/dev/null || { ok=0; detail="$detail [no judge after reviewer timeout]"; }
gc=$(sed -n 's/^GRANDCHILD=//p' "$rec"/*-reviewer-1-fable.env 2>/dev/null)
[ -n "$gc" ] || { ok=0; detail="$detail [the slow reviewer recorded no grandchild]"; }
judge_env=$(ls "$rec"/*-manager-1.env 2>/dev/null | head -1)
if [ -z "$judge_env" ] || ! grep -q '^GRANDCHILDREN_ALIVE=' "$judge_env"; then ok=0; detail="$detail [the judge's record has no GRANDCHILDREN_ALIVE line]"
elif [ -n "$gc" ] && pid_in "$gc" "$(sed -n 's/^GRANDCHILDREN_ALIVE=//p' "$judge_env")"; then ok=0; detail="$detail [grandchild $gc alive when the judge started]"; fi
[ -n "$gc" ] && kill -0 "$gc" 2>/dev/null && { ok=0; detail="$detail [grandchild $gc survived the Run]"; }
kill_recorded "$rec"
repo="$(new_repo)"; rec="$work/rec-tmo2"; t0=$(date +%s)
e=$(RLOOP_FAKE_PICK=ok:task RLOOP_FAKE_ROUNDS="impl=ok;panel=all;judge=done" RLOOP_FAKE_SLEEP_IMPLEMENTER=60 RLOOP_FAKE_IGNORE_TERM=1 run_rloop "$repo" "$rec" --run-dir "$repo/run" --implementer-timeout 1 --kill-after 1)
t1=$(date +%s)
[ $((t1 - t0)) -lt 10 ] && ls "$rec"/*-reviewer-1-fable.argv >/dev/null 2>&1 || { ok=0; detail="$detail [SIGTERM-ignoring implementer: ${t1}-${t0}s, exit $e]"; }
kill_recorded "$rec"
# A sleeping pick with the same child: AGT-15's first sentence. Both pids checked the moment the
# executable has returned; every ancestor is gone by then, so neither can be a zombie.
repo="$(new_repo)"; rec="$work/rec-tmo3"
e=$(RLOOP_FAKE_PICK=ok:task RLOOP_FAKE_SLEEP_MANAGER=30 RLOOP_FAKE_GRANDCHILD_IGNORE_TERM=1 run_rloop "$repo" "$rec" --run-dir "$repo/run" --manager-timeout 1 --kill-after 1)
[ "$e" = 2 ] || { ok=0; detail="$detail [manager timeout exit $e]"; }
for key in PID GRANDCHILD; do
  p=$(sed -n "s/^$key=//p" "$rec"/*-manager-0.env 2>/dev/null)
  [ -n "$p" ] || { ok=0; detail="$detail [the pick recorded no $key]"; continue; }
  kill -0 "$p" 2>/dev/null && { ok=0; detail="$detail [pick $key $p alive after exit $e]"; }
done
kill_recorded "$rec"
if [ "$ok" = 1 ]; then verdict CNF-17 ok "timeouts kill the group, the child that ignores SIGTERM included, and the Run goes on or ends as the role says"; else verdict CNF-17 fail "$detail"; fi

# --- CNF-18: interruption ------------------------------------------------------------------------------
ok=1; detail=""
for sig in INT TERM; do
  repo="$(new_repo)"; rec="$work/rec-sig-$sig"; mkdir -p "$rec"
  ( cd "$repo" && exec env --default-signal=INT,TERM PATH="$fakes:$private" RLOOP_FAKE_RECORD="$rec" RLOOP_FAKE_PICK=ok:task RLOOP_FAKE_ROUNDS="impl=ok;panel=all;judge=done" RLOOP_FAKE_SLEEP_IMPLEMENTER=60 RLOOP_FAKE_GRANDCHILD_IGNORE_TERM=1 \
      "$exe" --run-dir "$repo/run" --kill-after 1 </dev/null >"$rec/stdout" 2>"$rec/stderr" ) &
  rpid=$!
  for _ in $(seq 1 50); do ls "$rec"/*-implementer-1.env >/dev/null 2>&1 && break; sleep 0.2; done
  sleep 0.5; kill -"$sig" "$rpid"
  wait "$rpid"; e=$?
  [ "$e" = 2 ] || { ok=0; detail="$detail [$sig: exit $e]"; }
  grep -q interrupted "$rec/stderr" || { ok=0; detail="$detail [$sig: no 'interrupted']"; }
  grep -q SIGTERM "$rec"/*-implementer-1.env 2>/dev/null || { ok=0; detail="$detail [$sig: fake got no SIGTERM]"; }
  [ -f "$repo/run/task-1.md" ] || { ok=0; detail="$detail [$sig: run dir not intact]"; }
  for key in PID GRANDCHILD; do
    p=$(sed -n "s/^$key=//p" "$rec"/*-implementer-1.env 2>/dev/null | head -1)
    [ -n "$p" ] || { ok=0; detail="$detail [$sig: the implementer recorded no $key]"; continue; }
    kill -0 "$p" 2>/dev/null && { ok=0; detail="$detail [$sig: implementer $key $p survived]"; }
  done
  kill_recorded "$rec"
done
repo="$(new_repo)"; rec="$work/rec-sig2"; mkdir -p "$rec"
( cd "$repo" && exec env --default-signal=INT,TERM PATH="$fakes:$private" RLOOP_FAKE_RECORD="$rec" RLOOP_FAKE_PICK=ok:task RLOOP_FAKE_ROUNDS="impl=ok;panel=all;judge=done" RLOOP_FAKE_SLEEP_IMPLEMENTER=60 RLOOP_FAKE_IGNORE_TERM=1 \
    "$exe" --run-dir "$repo/run" --kill-after 30 </dev/null >"$rec/stdout" 2>"$rec/stderr" ) &
rpid=$!
for _ in $(seq 1 50); do ls "$rec"/*-implementer-1.env >/dev/null 2>&1 && break; sleep 0.2; done
sleep 0.5; kill -INT "$rpid"; sleep 1; kill -INT "$rpid"
t0=$(date +%s); wait "$rpid"; e=$?; t1=$(date +%s)
[ $((t1 - t0)) -lt 10 ] || { ok=0; detail="$detail [second SIGINT did not kill at once]"; }
for f in "$rec"/*.env; do ipid=$(sed -n 's/^PID=//p' "$f"); [ -n "$ipid" ] && kill -9 "$ipid" 2>/dev/null; done
if [ "$ok" = 1 ]; then verdict CNF-18 ok "SIGINT/SIGTERM forwarded, exit 2 'interrupted', nothing survives, run dir intact"; else verdict CNF-18 fail "$detail"; fi

# --- CNF-19: git ------------------------------------------------------------------------------------------
shim="$work/shim"; mkdir -p "$shim"; cp "$here/fakes/git-shim" "$shim/git"; chmod +x "$shim/git"
ok=1; detail=""
repo="$(new_repo)"; rec="$work/rec-git"; mkdir -p "$rec"
head0=$(cd "$repo" && git rev-parse HEAD); reflog0=$(cd "$repo" && git reflog | wc -l)
( cd "$repo" && PATH="$fakes:$shim:$private" RLOOP_FAKE_REAL_GIT="$real_git" RLOOP_FAKE_GIT_LOG="$rec/gitlog" RLOOP_FAKE_RECORD="$rec" \
    RLOOP_FAKE_PICK=ok:task RLOOP_FAKE_ROUNDS="impl=ok;panel=all;judge=rewrite|impl=ok;panel=all;judge=done" \
    "$exe" </dev/null >"$rec/stdout" 2>"$rec/stderr" ); e=$?
( cd "$repo" && PATH="$fakes:$shim:$private" RLOOP_FAKE_REAL_GIT="$real_git" RLOOP_FAKE_GIT_LOG="$rec/gitlog" RLOOP_FAKE_RECORD="$rec-seq" RLOOP_FAKE_RUNS="done,done,idle" \
    "$exe" --auto </dev/null >"$rec/stdout2" 2>"$rec/stderr2" ); e2=$?
bad_sub=$(grep -v -x -E 'rev-parse|status|diff|log' "$rec/gitlog" 2>/dev/null | sort -u | tr '\n' ' ')
head1=$(cd "$repo" && git rev-parse HEAD); reflog1=$(cd "$repo" && git reflog | wc -l)
[ -z "$bad_sub" ] || { ok=0; detail="$detail [git subcommands: $bad_sub]"; }
[ "$head0" = "$head1" ] && [ "$reflog0" = "$reflog1" ] || { ok=0; detail="$detail [HEAD or reflog changed]"; }
[ "$e" = 0 ] && [ "$e2" = 0 ] || { ok=0; detail="$detail [exits $e $e2]"; }
if [ "$ok" = 1 ]; then verdict CNF-19 ok "only read-only git subcommands; HEAD and reflog unchanged"; else verdict CNF-19 fail "$detail"; fi

# --- CNF-20: the Sequence ---------------------------------------------------------------------------------
ok=1; detail=""
repo="$(new_repo)"; rec="$work/rec-seq1"
e=$(RLOOP_FAKE_RUNS="done,done,idle" run_rloop "$repo" "$rec" --auto "drain it")
dirs=$(ls -d "$repo"/.rloop/runs/*/ 2>/dev/null | wc -l)
[ "$e" = 0 ] && [ "$dirs" = 3 ] || { ok=0; detail="$detail [done,done,idle: exit $e, $dirs dirs]"; }
expected_out=""
for d in $(ls -d "$repo"/.rloop/runs/*/ | sort); do n=$(sed -n 's/^RUN=//p' "$rec"/*-manager-0.env | head -1); : "$n"; done
i=0; for d in $(ls -d "$repo"/.rloop/runs/*/ | sort); do i=$((i + 1)); expected_out="$expected_out== run $i ==
$(cat "$d/finished.md")
"; done
[ "$(cat "$rec/stdout")" = "$(printf '%s' "$expected_out")" ] || { ok=0; detail="$detail [stdout format]"; }
sids=$(for f in "$rec"/*-manager-0.argv; do tr '\0' '\n' < "$f" | grep -A1 -x -- '--session-id' | tail -1; done | sort -u | wc -l)
[ "$sids" = 3 ] || { ok=0; detail="$detail [$sids distinct session ids]"; }
for f in "$rec"/*-manager-0.argv; do tr '\0' '\n' < "$f" | grep -q 'drain it' || { ok=0; detail="$detail [instruction missing in a pick]"; }; done
repo="$(new_repo)"; rec="$work/rec-seq2"
e=$(RLOOP_FAKE_RUNS="done,blocked,idle" run_rloop "$repo" "$rec" --auto)
[ "$e" = 1 ] && [ "$(ls "$rec"/*-manager-0.argv | wc -l)" = 2 ] || { ok=0; detail="$detail [done,blocked: exit $e, $(ls "$rec"/*-manager-0.argv | wc -l) picks]"; }
repo="$(new_repo)"; rec="$work/rec-seq3"
e=$(RLOOP_FAKE_RUNS="done,done,done,done,done" run_rloop "$repo" "$rec" --auto --max-runs 3)
[ "$e" = 2 ] && [ "$(ls "$rec"/*-manager-0.argv | wc -l)" = 3 ] || { ok=0; detail="$detail [max-runs 3: exit $e, $(ls "$rec"/*-manager-0.argv | wc -l) picks]"; }
repo="$(new_repo)"; rec="$work/rec-seq4"
e=$(RLOOP_FAKE_RUNS="done,done,fail" run_rloop "$repo" "$rec" --auto)
[ "$e" = 2 ] && [ "$(grep -c '^== run' "$rec/stdout")" = 2 ] || { ok=0; detail="$detail [done,done,fail: exit $e, $(grep -c '^== run' "$rec/stdout") run headers on stdout]"; }
# Run 2 ends 2 with a Finished File on disk (RUN-11): SEQ-7 keeps it off standard output, which
# must be byte-identical to Run 1's block alone. Two shapes: a pick whose first line is not a
# status, and a judge that wrote STATUS: idle after a Round.
for shape in "done,other:" "done,task:impl=ok;panel=all;judge=idle"; do
  runs="${shape%%:*}"; rounds="${shape#*:}"
  repo="$(new_repo)"; rec="$work/rec-seq-2-${runs#done,}"
  e=$(RLOOP_FAKE_RUNS="$runs" RLOOP_FAKE_ROUNDS="$rounds" run_rloop "$repo" "$rec" --auto)
  dirs=$(ls -d "$repo"/.rloop/runs/*/ 2>/dev/null | sort)
  run1="$(echo "$dirs" | sed -n 1p)"; run2="$(echo "$dirs" | sed -n 2p)"
  [ "$e" = 2 ] && [ "$(echo "$dirs" | wc -l)" = 2 ] && [ -f "$run2/finished.md" ] || { ok=0; detail="$detail [$runs: exit $e, $(echo "$dirs" | wc -l) dirs, Run 2 finished.md $([ -f "$run2/finished.md" ] && echo present || echo absent)]"; }
  { echo "== run 1 =="; cat "$run1/finished.md"; } > "$rec/expected-stdout"
  cmp -s "$rec/stdout" "$rec/expected-stdout" && [ -s "$rec/stderr" ] || { ok=0; detail="$detail [$runs: stdout is not Run 1's block alone, or stderr empty]"; }
done
if [ "$ok" = 1 ]; then verdict CNF-20 ok "Sequence: idle ends 0, blocked ends 1, cap ends 2; fresh sessions; stdout per Run, none for a Run that ended 2"; else verdict CNF-20 fail "$detail"; fi

# --- CNF-21: the clean-tree check ---------------------------------------------------------------------
ok=1; detail=""
repo="$(new_repo)"; rec="$work/rec-clean"
e=$(RLOOP_FAKE_RUNS="done,done,idle" RLOOP_FAKE_DIRTY_AT_DONE=1 run_rloop "$repo" "$rec" --auto)
[ "$e" = 2 ] && [ "$(ls "$rec"/*-manager-0.argv | wc -l)" = 1 ] || { ok=0; detail="$detail [dirty between runs: exit $e, $(ls "$rec"/*-manager-0.argv | wc -l) picks]"; }
repo="$(new_repo)"; rec="$work/rec-clean2"
e=$(RLOOP_FAKE_PICK=ok:done RLOOP_FAKE_DIRTY_AT_DONE=1 run_rloop "$repo" "$rec" --run-dir "$repo/run")
[ "$e" = 0 ] && [ -s "$rec/stderr" ] || { ok=0; detail="$detail [lone dirty done: exit $e]"; }
if [ "$ok" = 1 ]; then verdict CNF-21 ok "a dirty tree stops a Sequence before the next pick; a lone Run only warns"; else verdict CNF-21 fail "$detail"; fi

# --- CNF-24: the probe runs once before the pick, and once a Round between the Implementer and the Panel
ok=1; detail=""
repo="$(new_repo)"; rec="$work/rec-probe"
e=$(RLOOP_FAKE_PICK=ok:task RLOOP_FAKE_ROUNDS="impl=ok;panel=all;judge=rewrite|impl=ok;panel=all;judge=done" run_rloop "$repo" "$rec" --run-dir "$repo/run")
[ "$e" = 0 ] || { ok=0; detail="$detail [exit $e]"; }
# The probe is trace-invisible by design (AGT-18), so order is read from the record's NNN- prefix.
# Prints -1 when nothing matched; every caller must reject that explicitly, because -1 satisfies
# `-1 -lt <anything>` and a missing spawn would otherwise pass an ordering test.
seq_of() { local f; f=$(ls "$rec"/*-"$1".argv 2>/dev/null | head -1); if [ -z "$f" ]; then echo -1; return; fi; f=$(basename "$f"); echo "${f%%-*}"; }
present() { [ "$2" != -1 ] || { ok=0; detail="$detail [$1 never spawned]"; return 1; }; }
# AGT-12 and AGT-13, which CNF-24 cites: the probe's environment, working directory and closed stdin.
check_probe_env() { # check_probe_env <record tag> <RLOOP_ROUND> <label>
  local ef; ef=$(ls "$rec"/*-"$1".env 2>/dev/null | head -1)
  if [ -z "$ef" ]; then ok=0; detail="$detail [$3: no probe env recorded]"; return; fi
  grep -qx "ROLE=probe" "$ef"   || { ok=0; detail="$detail [$3: probe ROLE]"; }
  grep -qx "ROUND=$2" "$ef"     || { ok=0; detail="$detail [$3: probe ROUND]"; }
  grep -qx "STDIN=eof" "$ef"    || { ok=0; detail="$detail [$3: probe stdin not closed]"; }
  grep -qx "CWD=$(cd "$repo" && pwd -P)" "$ef" || { ok=0; detail="$detail [$3: probe cwd]"; }
}
# byte for byte, not merely present: the fake's `clear` shape writes exactly this line
clear_bytes() { printf 'Current week (all models): 67%% used · resets Sep 24, 3pm (UTC)\n'; }
n=$(ls "$rec"/*-probe-0.argv 2>/dev/null | wc -l)
if [ "$n" = 1 ]; then
  p=$(seq_of probe-0); m=$(seq_of manager-0)
  present "the pick" "$m" && { [ "$p" -lt "$m" ] || { ok=0; detail="$detail [the pick's probe not before the pick]"; }; }
  check_probe_env probe-0 0 "the pick"
else ok=0; detail="$detail [the pick: $n probe calls]"; fi
[ -f "$repo/run/probe-pick.err" ] || { ok=0; detail="$detail [the pick: probe-pick.err missing]"; }
clear_bytes | cmp -s - "$repo/run/probe-pick.out" || { ok=0; detail="$detail [the pick: probe-pick.out is not the probe's bytes]"; }
for r in 1 2; do
  n=$(ls "$rec"/*-probe-"$r".argv 2>/dev/null | wc -l)
  [ "$n" = 1 ] || { ok=0; detail="$detail [round $r: $n probe calls]"; continue; }
  p=$(seq_of "probe-$r"); i=$(seq_of "implementer-$r")
  present "round $r implementer" "$i" && present "round $r probe" "$p" &&
    { [ "$i" -lt "$p" ] || { ok=0; detail="$detail [round $r: probe not after the Implementer]"; }; }
  for rv in fable opus astra sol; do
    v=$(seq_of "reviewer-$r-$rv")
    present "round $r $rv" "$v" &&
      { [ "$p" -lt "$v" ] || { ok=0; detail="$detail [round $r: probe not before $rv]"; }; }
  done
  check_probe_env "probe-$r" "$r" "round $r"
  [ -f "$repo/run/probe-$r.err" ] || { ok=0; detail="$detail [round $r: probe-$r.err missing]"; }
  clear_bytes | cmp -s - "$repo/run/probe-$r.out" || { ok=0; detail="$detail [round $r: probe-$r.out is not the probe's bytes]"; }
done
ls "$repo/run"/probe-0.* >/dev/null 2>&1 && { ok=0; detail="$detail [a probe-0.* file: the pick's record is probe-pick.*]"; }
for tag in probe-0 probe-1 probe-2; do
  f=$(ls "$rec"/*-$tag.argv 2>/dev/null | head -1)
  [ -n "$f" ] || { ok=0; detail="$detail [$tag never spawned]"; continue; }
  tr '\0' '\n' < "$f" | cmp -s - "$here/fixtures/argv/AGT-18.txt" || { ok=0; detail="$detail [$tag argv is not AGT-18's fixture]"; }
done
if [ "$ok" = 1 ]; then verdict CNF-24 ok "one probe before the pick and one a Round, after the Implementer and before every Reviewer, argv as AGT-18"; else verdict CNF-24 fail "$detail"; fi

# --- CNF-25: the recorded verdicts --------------------------------------------------------------------
ok=1; detail=""
repo="$(new_repo)"; rec="$work/rec-probe-verdict"
e=$(RLOOP_FAKE_PICK=ok:task RLOOP_FAKE_PROBE=fable RLOOP_FAKE_ROUNDS="impl=ok;panel=all;judge=done" run_rloop "$repo" "$rec" --run-dir "$repo/run" "${off[@]}")
record_is "$repo/run/probe-1.md" "fable row" unknown unknown unavailable unknown unknown unknown
# The verdict alone is not enough: an Implementation could write it and then abort, or act on it
# early. RUN-15 removes exactly the Reviewer read `unavailable` and no other, so the Run must
# finish and every other Reviewer must have been called.
# RUN-15: the Reviewer read `unavailable` is the one that must NOT be called, and every other
# must be. Asserting all four here would contradict CNF-27 and no Implementation could pass both.
check_run_whole() { # check_run_whole <label> <the unavailable reviewer>
  [ "$e" = 0 ] || { ok=0; detail="$detail [$1: exit $e]"; }
  [ -f "$repo/run/finished.md" ] || { ok=0; detail="$detail [$1: no Finished File]"; }
  for rv in fable opus astra sol; do
    if [ "$rv" = "$2" ]; then
      ls "$rec"/*-reviewer-1-"$rv".argv >/dev/null 2>&1 && { ok=0; detail="$detail [$1: $rv called though unavailable]"; }
    else
      ls "$rec"/*-reviewer-1-"$rv".argv >/dev/null 2>&1 || { ok=0; detail="$detail [$1: $rv not spawned]"; }
    fi
  done
}
check_run_whole "fable row" fable
# The other row of the table, so a rule that hardcodes `fable` cannot pass.
repo="$(new_repo)"; rec="$work/rec-probe-verdict-opus"
e=$(RLOOP_FAKE_PICK=ok:task RLOOP_FAKE_PROBE=opus RLOOP_FAKE_ROUNDS="impl=ok;panel=all;judge=done" run_rloop "$repo" "$rec" --run-dir "$repo/run" "${off[@]}")
record_is "$repo/run/probe-1.md" "opus row" unknown unknown unknown unavailable unknown unknown
check_run_whole "opus row" opus
# The Implementer's Seat on `fable`'s model: its verdict is read from its own model, not copied from
# a Reviewer's line, and a Round's verdict on it is recorded and acted on by nothing (RUN-22).
repo="$(new_repo)"; rec="$work/rec-probe-verdict-seat"
e=$(RLOOP_FAKE_PICK=ok:task RLOOP_FAKE_PROBE=fable RLOOP_FAKE_ROUNDS="impl=ok;panel=all;judge=done" run_rloop "$repo" "$rec" --run-dir "$repo/run" --manager-model "$off_table_model" --implementer-model claude-fable-5-1)
record_is "$repo/run/probe-1.md" "Implementer's Seat on the table" unknown unavailable unavailable unknown unknown unknown
ls "$rec"/*-manager-1.argv >/dev/null 2>&1 || { ok=0; detail="$detail [Implementer's Seat on the table: judge not called]"; }
check_run_whole "Implementer's Seat on the table" fable
if [ "$ok" = 1 ]; then verdict CNF-25 ok "six lines, one per Seat; either family at 100% reads unavailable, alone, and a Seat reads its own model"; else verdict CNF-25 fail "$detail"; fi

# --- CNF-26: fail open ---------------------------------------------------------------------------------
ok=1; detail=""
for shape in clear aggregate fail silent garbage under loose nul slow; do
  repo="$(new_repo)"; rec="$work/rec-probe-$shape"
  # `slow` is the bound being hit: the probe sleeps past a --probe-timeout of one second. It is
  # scripted to report fable at 100% precisely so the row can fail — an Implementation that
  # ignores the bound lets that output through and reads `fable:unavailable`, while one that
  # honours it kills the probe before it prints and reads `unknown`. Scripting `clear` here would
  # give the same verdict either way and test nothing.
  written="$shape"; sleep_probe=0; bound=()
  if [ "$shape" = slow ]; then written=fable; sleep_probe=3; bound=(--probe-timeout 1); fi
  e=$(RLOOP_FAKE_PICK=ok:task RLOOP_FAKE_PROBE="$written" RLOOP_FAKE_SLEEP_PROBE="$sleep_probe" RLOOP_FAKE_ROUNDS="impl=ok;panel=all;judge=done" run_rloop "$repo" "$rec" --run-dir "$repo/run" "${off[@]}" ${bound[@]+"${bound[@]}"})
  [ "$e" = 0 ] || { ok=0; detail="$detail [$shape: exit $e]"; }
  [ -f "$repo/run/finished.md" ] || { ok=0; detail="$detail [$shape: no Finished File]"; }
  ls "$rec"/*-manager-1.argv >/dev/null 2>&1 || { ok=0; detail="$detail [$shape: judge not called]"; }
  record_is "$repo/run/probe-1.md" "$shape" unknown unknown unknown unknown unknown unknown
  for rv in fable opus astra sol; do
    ls "$rec"/*-reviewer-1-"$rv".argv >/dev/null 2>&1 || { ok=0; detail="$detail [$shape: $rv not spawned]"; }
  done
done
if [ "$ok" = 1 ]; then verdict CNF-26 ok "aggregate exhaustion or a failed, silent, unparseable, under-100%, mid-line, NUL-split or timed-out probe leaves every Seat unknown and the Panel whole"; else verdict CNF-26 fail "$detail"; fi

# --- CNF-27: an unavailable Reviewer is recorded in place, never called -------------------------------
ok=1; detail=""
for shape in fable both; do
  repo="$(new_repo)"; rec="$work/rec-omitted-$shape"
  # panel=all keeps the called Reviewers successful even when fable is omitted.
  e=$(RLOOP_FAKE_PICK=ok:task RLOOP_FAKE_PROBE="$shape" RLOOP_FAKE_ROUNDS="impl=ok;panel=all;judge=done" run_rloop "$repo" "$rec" --run-dir "$repo/run" "${off[@]}")
  [ "$e" = 0 ] || { ok=0; detail="$detail [$shape: exit $e]"; }
  [ -f "$repo/run/finished.md" ] || { ok=0; detail="$detail [$shape: no Finished File]"; }
  opus_verdict=unknown; [ "$shape" = both ] && opus_verdict=unavailable
  record_is "$repo/run/probe-1.md" "$shape" unknown unknown unavailable "$opus_verdict" unknown unknown
  jf=$(ls "$rec"/*-manager-1.argv 2>/dev/null | head -1)
  [ -n "$jf" ] || { ok=0; detail="$detail [$shape: judge not called]"; }
  for rv in fable opus astra sol; do
    if [ "$rv" = fable ] || { [ "$shape" = both ] && [ "$rv" = opus ]; }; then
      ls "$rec"/*-reviewer-1-"$rv".argv >/dev/null 2>&1 && { ok=0; detail="$detail [$shape: $rv was called]"; }
      # Byte comparison preserves trailing blank lines, which command substitution would strip.
      printf 'REVIEWER NOT RUN (unavailable)\n' | cmp -s - "$repo/run/feedback-1-$rv.md" \
        || { ok=0; detail="$detail [$shape: $rv feedback is not exactly the not-run line]"; }
      [ -f "$repo/run/reviewer-1-$rv.err" ] && [ ! -s "$repo/run/reviewer-1-$rv.err" ] \
        || { ok=0; detail="$detail [$shape: $rv .err missing or not empty]"; }
    else
      ls "$rec"/*-reviewer-1-"$rv".argv >/dev/null 2>&1 || { ok=0; detail="$detail [$shape: $rv not called]"; }
    fi
    # RUN-15: "It stays a Reviewer of the Panel"; check every Feedback File path at the judge.
    [ -n "$jf" ] && tr '\0' '\n' < "$jf" | grep -Fq -- "$repo/run/feedback-1-$rv.md" \
      || { ok=0; detail="$detail [$shape: judge was not given $rv's Feedback File]"; }
  done
done
# Mixed down states: one Reviewer never called and the other three failing is still "every
# Reviewer of a Panel is down", so RUN-15 aborts. Nothing else exercises the two kinds together.
repo="$(new_repo)"; rec="$work/rec-omitted-abort"
e=$(RLOOP_FAKE_PICK=ok:task RLOOP_FAKE_PROBE=fable RLOOP_FAKE_ROUNDS="impl=ok;panel=none;judge=done" run_rloop "$repo" "$rec" --run-dir "$repo/run" "${off[@]}")
[ "$e" = 2 ] || { ok=0; detail="$detail [one unavailable plus three failed: exit $e, want 2]"; }
ls "$rec"/*-manager-1.argv >/dev/null 2>&1 && { ok=0; detail="$detail [judge ran with no survivor]"; }
[ -f "$repo/run/finished.md" ] && { ok=0; detail="$detail [Finished File written with no survivor]"; }
if [ "$ok" = 1 ]; then verdict CNF-27 ok "one or both families unavailable: omitted Reviewers recorded in place and all feedback reaches the judge; all down aborts"; else verdict CNF-27 fail "$detail"; fi

# --- CNF-28, CNF-29: a Seat that cannot answer refuses the Run at the pick -------------------------------
# The pick is scripted to fail, so an Implementation that ignores the refusal and calls it exits 2
# as well: the spawn record, not the status, is what these items assert.
agents_spawned() { ls "$rec" 2>/dev/null | grep -cE '^[0-9]+-(manager|implementer|reviewer)-.*\.argv$'; }
refused() { # refused <label>: the Run in $repo, recorded in $rec, was refused at the pick
  local n
  [ "$e" = 2 ] || { ok=0; detail="$detail [$1: exit $e]"; }
  n=$(agents_spawned); [ "$n" = 0 ] || { ok=0; detail="$detail [$1: $n agent calls recorded]"; }
  [ "$(ls "$rec"/*-probe-0.argv 2>/dev/null | wc -l)" = 1 ] || { ok=0; detail="$detail [$1: the probe before the pick did not run once]"; }
  [ -s "$rec/stdout" ] && { ok=0; detail="$detail [$1: standard output is not empty]"; }
  [ "$(ls "$repo/run" 2>/dev/null | LC_ALL=C sort | tr '\n' ' ')" = "probe-pick.err probe-pick.md probe-pick.out " ] \
    || { ok=0; detail="$detail [$1: the Run Directory holds $(ls "$repo/run" 2>/dev/null | tr '\n' ' ')]"; }
}
seat_words() { sed -E 's/-*(manager|implementer)-model//g' "$rec/stderr"; } # each flag's name carries a Seat's word
names() { # names <label> <text...>: standard error carries each text; a Seat's word must stand apart from the flag names
  local label="$1" t; shift
  for t in "$@"; do
    case $t in
      manager|implementer) seat_words | grep -qwF -- "$t" ;;
      *) grep -qF -- "$t" "$rec/stderr" ;;
    esac || { ok=0; detail="$detail [$label: standard error does not name '$t']"; }
  done
}
fable_line='Current week (Fable): 100% used · resets Sep 24, 3pm (UTC)'
opus_line='Current week (Opus): 100% used · resets Sep 24, 3pm (UTC)'
ok=1; detail=""
repo="$(new_repo)"; rec="$work/rec-refuse-manager"
e=$(RLOOP_FAKE_PICK=fail RLOOP_FAKE_PROBE_PICK=fable run_rloop "$repo" "$rec" --run-dir "$repo/run")
refused "default models"
names "default models" manager implementer claude-fable-5-1 "$fable_line"
record_is "$repo/run/probe-pick.md" "default models" unavailable unavailable unavailable unknown unknown unknown
# The table's other row, so a rule that hardcodes `fable` for the Manager's Seat cannot pass.
repo="$(new_repo)"; rec="$work/rec-refuse-manager-opus"
e=$(RLOOP_FAKE_PICK=fail RLOOP_FAKE_PROBE_PICK=opus run_rloop "$repo" "$rec" --run-dir "$repo/run" --manager-model claude-opus-5 --implementer-model "$off_table_model")
refused "claude-opus-5"
names "claude-opus-5" manager claude-opus-5 "$opus_line"
record_is "$repo/run/probe-pick.md" "claude-opus-5" unavailable unknown unknown unavailable unknown unknown
if [ "$ok" = 1 ]; then verdict CNF-28 ok "a Manager's Seat recorded unavailable before the pick: exit 2, no agent spawned, only probe-pick.*, the Seat, model and line named"; else verdict CNF-28 fail "$detail"; fi

ok=1; detail=""
repo="$(new_repo)"; rec="$work/rec-refuse-implementer"
e=$(RLOOP_FAKE_PICK=fail RLOOP_FAKE_PROBE_PICK=fable run_rloop "$repo" "$rec" --run-dir "$repo/run" --manager-model "$off_table_model")
refused "Implementer's Seat"
names "Implementer's Seat" implementer claude-fable-5-1 "$fable_line"
record_is "$repo/run/probe-pick.md" "Implementer's Seat" unknown unavailable unavailable unknown unknown unknown
# The table's other row, so a rule that hardcodes `fable` for the Implementer's Seat cannot pass.
repo="$(new_repo)"; rec="$work/rec-refuse-implementer-opus"
e=$(RLOOP_FAKE_PICK=fail RLOOP_FAKE_PROBE_PICK=opus run_rloop "$repo" "$rec" --run-dir "$repo/run" --manager-model "$off_table_model" --implementer-model claude-opus-5)
refused "Implementer's Seat on claude-opus-5"
names "Implementer's Seat on claude-opus-5" implementer claude-opus-5 "$opus_line"
record_is "$repo/run/probe-pick.md" "Implementer's Seat on claude-opus-5" unknown unavailable unknown unavailable unknown unknown
if [ "$ok" = 1 ]; then verdict CNF-29 ok "an Implementer's Seat recorded unavailable before the pick, on either row: exit 2, no agent spawned, the Seat, model and line named"; else verdict CNF-29 fail "$detail"; fi

# --- CNF-30: no judge call for a Manager's Seat recorded unavailable ------------------------------------
# The withheld judge is scripted to fail, so calling it would exit 2 as well: the missing judge,
# not the status, is what this item asserts.
ok=1; detail=""
for row in fable opus; do # the Manager's Seat on each row of RUN-21's table, so a Round's reading cannot hardcode `fable`
  case $row in
    fable) model=claude-fable-5-1; line=$fable_line; seats=(--implementer-model "$off_table_model")
      verdicts=(unavailable unknown unavailable unknown unknown unknown) ;;
    opus) model=claude-opus-5; line=$opus_line; seats=(--manager-model claude-opus-5 --implementer-model "$off_table_model")
      verdicts=(unavailable unknown unknown unavailable unknown unknown) ;;
  esac
  repo="$(new_repo)"; rec="$work/rec-judge-guard-$row"
  e=$(RLOOP_FAKE_PICK=ok:task RLOOP_FAKE_PROBE="clear|$row" RLOOP_FAKE_ROUNDS="impl=ok;panel=all;judge=rewrite|impl=ok;panel=all;judge=fail" run_rloop "$repo" "$rec" --run-dir "$repo/run" "${seats[@]}")
  [ "$e" = 2 ] || { ok=0; detail="$detail [Round 2, $model: exit $e]"; }
  [ -f "$repo/run/manager-judge-1.out" ] || { ok=0; detail="$detail [Round 2, $model: no manager-judge-1.out]"; }
  [ -e "$repo/run/manager-judge-2.out" ] && { ok=0; detail="$detail [Round 2, $model: manager-judge-2.out exists]"; }
  ls "$rec"/*-manager-2.argv >/dev/null 2>&1 && { ok=0; detail="$detail [Round 2, $model: its judge was called]"; }
  ls "$rec"/*-implementer-2.argv >/dev/null 2>&1 || { ok=0; detail="$detail [Round 2, $model: no Implementer]"; }
  for rv in fable opus astra sol; do
    [ "$rv" = "$row" ] && continue
    ls "$rec"/*-reviewer-2-$rv.argv >/dev/null 2>&1 || { ok=0; detail="$detail [Round 2, $model: $rv not called]"; }
  done
  ls "$rec"/*-reviewer-2-$row.argv >/dev/null 2>&1 && { ok=0; detail="$detail [Round 2, $model: $row called]"; }
  printf 'REVIEWER NOT RUN (unavailable)\n' | cmp -s - "$repo/run/feedback-2-$row.md" || { ok=0; detail="$detail [Round 2, $model: feedback-2-$row.md is not the not-run line]"; }
  [ -e "$repo/run/finished.md" ] && { ok=0; detail="$detail [Round 2, $model: a Finished File]"; }
  [ -s "$rec/stdout" ] && { ok=0; detail="$detail [Round 2, $model: standard output is not empty]"; }
  names "Round 2, $model" manager "$model" "$line"
  record_is "$repo/run/probe-2.md" "Round 2, $model" "${verdicts[@]}"
  repo="$(new_repo)"; rec="$work/rec-judge-guard-1-$row"
  e=$(RLOOP_FAKE_PICK=ok:task RLOOP_FAKE_PROBE=$row RLOOP_FAKE_ROUNDS="impl=ok;panel=all;judge=fail" run_rloop "$repo" "$rec" --run-dir "$repo/run" "${seats[@]}")
  [ "$e" = 2 ] || { ok=0; detail="$detail [Round 1, $model: exit $e]"; }
  [ -e "$repo/run/manager-judge-1.out" ] && { ok=0; detail="$detail [Round 1, $model: manager-judge-1.out exists]"; }
  ls "$rec"/*-manager-1.argv >/dev/null 2>&1 && { ok=0; detail="$detail [Round 1, $model: its judge was called]"; }
  names "Round 1, $model" manager "$model" "$line"
done
if [ "$ok" = 1 ]; then verdict CNF-30 ok "a Manager's Seat recorded unavailable in Round 1 or 2, on either row: the Panel runs, no judge is called, exit 2"; else verdict CNF-30 fail "$detail"; fi

# --- CNF-31: fail open reaches the pick --------------------------------------------------------------------
started() { # started <label>: the Run was not refused; the pick was called and the Run ended 0
  [ "$e" = 0 ] || { ok=0; detail="$detail [$1: exit $e]"; }
  ls "$rec"/*-manager-0.argv >/dev/null 2>&1 || { ok=0; detail="$detail [$1: the pick was not called]"; }
  [ -f "$repo/run/finished.md" ] || { ok=0; detail="$detail [$1: no Finished File]"; }
}
ok=1; detail=""
for shape in fable both; do
  repo="$(new_repo)"; rec="$work/rec-open-seats-$shape"
  e=$(RLOOP_FAKE_PICK=ok:task RLOOP_FAKE_PROBE_PICK="$shape" RLOOP_FAKE_ROUNDS="impl=ok;panel=all;judge=done" run_rloop "$repo" "$rec" --run-dir "$repo/run" "${off[@]}")
  started "$shape, Seats off the table"
  opus_verdict=unknown; [ "$shape" = both ] && opus_verdict=unavailable
  record_is "$repo/run/probe-pick.md" "$shape, Seats off the table" unknown unknown unavailable "$opus_verdict" unknown unknown
done
for shape in fail loose under silent unlisted aggregate garbage slow; do
  repo="$(new_repo)"; rec="$work/rec-open-pick-$shape"
  # `slow` reports `Fable` at 100% after sleeping past a one-second bound, as in CNF-26: only an
  # Implementation that honours the bound reads it `unknown`.
  written="$shape"; sleep_probe=0; bound=()
  if [ "$shape" = slow ]; then written=fable; sleep_probe=3; bound=(--probe-timeout 1); fi
  e=$(RLOOP_FAKE_PICK=ok:task RLOOP_FAKE_PROBE_PICK="$written" RLOOP_FAKE_SLEEP_PROBE="$sleep_probe" RLOOP_FAKE_ROUNDS="impl=ok;panel=all;judge=done" run_rloop "$repo" "$rec" --run-dir "$repo/run" ${bound[@]+"${bound[@]}"})
  started "$shape, default models"
  record_is "$repo/run/probe-pick.md" "$shape, default models" unknown unknown unknown unknown unknown unknown
done
if [ "$ok" = 1 ]; then verdict CNF-31 ok "Seats off the table, or a probe before the pick that reads unknown, start the Run"; else verdict CNF-31 fail "$detail"; fi

# --- CNF-32: the unavailable list in the pick prompt ----------------------------------------------------
# `opus` on the default models (a `Fable` report would refuse them, RUN-22), `fable` alone and both
# Reviewers with the two Seats' models off the table, and none: either form alone passes a wrong
# Implementation, and one Seat's Run alone passes one that hardcodes that Seat.
# Each Run must start (CNF-31's started()); check_call's argv verdict is CNF-11's, so it is dropped.
ok=1; detail=""; prompt_ok=1; prompt_detail=""
for shape in opus fable both clear; do
  repo="$(new_repo)"; rec="$work/rec-unavailable-$shape"; seats=(); model=claude-fable-5-1
  case $shape in
    opus) P_UNAVAILABLE="opus" ;;
    fable) P_UNAVAILABLE="fable"; seats=("${off[@]}"); model="$off_table_model" ;;
    both) P_UNAVAILABLE="fable
opus"; seats=("${off[@]}"); model="$off_table_model" ;;
    clear) P_UNAVAILABLE="" ;;
  esac
  e=$(RLOOP_FAKE_PICK=ok:done RLOOP_FAKE_PROBE_PICK="$shape" run_rloop "$repo" "$rec" --run-dir "$repo/run" ${seats[@]+"${seats[@]}"})
  started "$shape"; started_ok=$ok; started_detail="$detail"
  P_INSTRUCTION=""; P_TASK_FILE="$repo/run/task.md"; P_FINISHED_FILE="$repo/run/finished.md"; P_RUN_DIR="$repo/run"; P_DIRTY_AT_START=""
  check_call "$rec/*-manager-0.argv" "$fx/argv/AGT-3-1.txt" "$fx/prompts/PRM-1.txt" "$(cat "$repo/run/session" 2>/dev/null)" "$model" "$shape"
  ok=$started_ok; detail="$started_detail"
done
if [ "$ok" = 1 ] && [ "$prompt_ok" = 1 ]; then verdict CNF-32 ok "the pick prompt lists the Reviewer Seats the Probe before the pick read unavailable: opus; fable; fable and opus; none"; else verdict CNF-32 fail "$detail $prompt_detail"; fi

verdict CNF-22 ok "(live; by hand once per release — see 06-conformance.md)"

echo
echo "$pass passed, $fail failed"
[ "$fail" = 0 ] || { echo "failed: ${failed_items[*]}"; exit 1; }
exit 0
