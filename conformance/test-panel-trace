#!/usr/bin/env bash
# Regression checks for the suite's Panel-membership comparator, observed_trace in
# scenario-lib.sh, for the fake past a script's last Round and last probe shape, and for the skip
# and the two refusals of restrict_path, the same library's executable PATH (CNF-2), with only the
# Conformance Suite's dependencies. Always invoked directly:
#   spec/conformance/test-panel-trace ./result/bin/rloop    in the CI of rloop-bash
#   conformance/test-panel-trace                            as tools/check-all.sh runs it
# Without an argument the hand-written traces, the fake's fallthrough and restrict_path's three
# outcomes are checked, and one NOT RUN line names the checks that need an executable: the
# fake-agent timeout, the positive scenario replays and the mutants. The mutants are pinned to
# rloop-bash's source, its two literal Reviewer loops in do_round and its probe reading (RUN-21),
# and to no other Implementation's, so the argument must be the rloop-bash script. Mutants are
# made only in scratch space; neither the executable nor its checkout is modified. The normal
# Conformance Suite remains implementation-independent. No expected scenario is edited here.
set -u
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
original=
if [ "$#" -ge 1 ]; then
  [ -f "$1" ] && [ -x "$1" ] || { echo "not executable: $1" >&2; exit 2; }
  original="$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"
fi
# No die() yet, it is defined below; a TMPDIR that vanished mid-run left work empty and the
# failure was named by a later cp.
work="$(mktemp -d "${TMPDIR:-/tmp}/rloop-panel-trace.XXXXXX")" \
  || { echo "FAIL: mktemp -d under ${TMPDIR:-/tmp} made no scratch directory" >&2; exit 1; }
trap 'rm -rf "$work"' EXIT
source "$here/scenario-lib.sh"
die() { echo "FAIL: $*" >&2; exit 1; }
assert_equal() { [ "$1" = "$2" ] || die "$3: expected '$2', got '$1'"; }
fakes="$work/fakes"; mkdir -p "$fakes"
cp "$here/fakes/agent" "$fakes/claude" && cp "$here/fakes/agent" "$fakes/codex" || exit 1
chmod +x "$fakes/claude" "$fakes/codex"
restrict_path

# Exercise completion order deterministically using the fake agents' record format. Both
# permutations have the same identity-specific outcomes; failures still count as members.
rec="$work/order"; mkdir -p "$rec"
members=astra+fable+opus+sol
for cls in all some none; do
  for order in 'fable opus astra sol' 'sol astra opus fable'; do
    printf 'manager:0:end:1:ok:task\nimplementer:1:end:2:ok\n' > "$rec/trace"
    timestamp=3
    for reviewer in $order; do
      outcome=fail
      if [ "$cls" = all ] || { [ "$cls" = some ] && [ "$reviewer" = fable ]; }; then
        outcome=ok
      fi
      printf 'reviewer:1:%s:start:2\nreviewer:1:%s:end:%s:%s\n' \
        "$reviewer" "$reviewer" "$timestamp" "$outcome" >> "$rec/trace"
      timestamp=$((timestamp + 1))
    done
    expected="pick,impl1:ok,panel1:$cls:$members"
    if [ "$cls" != none ]; then
      echo 'manager:1:end:7:done' >> "$rec/trace"
      expected+=,judge1
    fi
    assert_equal "$(observed_trace "$rec")" "$expected" "$cls in order $order"
  done
  echo "PASS: $cls membership in both completion orders"
done

# Equal counts with different identities must differ, and neither membership nor outcomes
# may leak across Round or non-Panel boundaries.
cat > "$rec/trace" <<'TRACE'
manager:0:end:1:ok:task
implementer:1:end:2:fail
reviewer:1:sol:end:3:fail
reviewer:1:astra:end:4:ok
manager:1:end:5:rewrite
implementer:2:end:6:ok
reviewer:2:opus:end:7:fail
reviewer:2:fable:end:8:fail
TRACE
assert_equal "$(observed_trace "$rec")" \
  'pick,impl1:fail,panel1:some:astra+sol,judge1,impl2:ok,panel2:none:fable+opus' \
  'independent Round membership and outcomes'
# Even adjacent Panels must flush on a changed Round, without borrowing a Manager boundary.
sed '/manager:1:/d; /implementer:2:/d' "$rec/trace" > "$rec/adjacent"
mv "$rec/adjacent" "$rec/trace"
assert_equal "$(observed_trace "$rec")" \
  'pick,impl1:fail,panel1:some:astra+sol,panel2:none:fable+opus' 'adjacent Round boundary'
echo 'PASS: identities, Round boundaries and non-Panel order'

# Starts without ends represent Reviewers that ran but did not complete. A successful
# completion replaces its start's failed outcome rather than counting as a second member.
cat > "$rec/trace" <<'TRACE'
manager:0:end:1:ok:task
implementer:1:end:2:ok
reviewer:1:sol:start:3
reviewer:1:opus:start:4
reviewer:1:fable:start:5
reviewer:1:astra:start:6
reviewer:1:astra:end:7:ok
reviewer:1:fable:end:8:ok
reviewer:1:opus:end:9:ok
manager:1:end:10:rewrite
TRACE
assert_equal "$(observed_trace "$rec")" \
  "pick,impl1:ok,panel1:some:$members,judge1" 'mixed success and timeout'
# The same identity succeeds next Round, while the other Reviewers have no evidence of
# running. Neither the previous timeout nor the previous membership may carry forward.
cat >> "$rec/trace" <<'TRACE'
implementer:2:end:11:ok
reviewer:2:sol:start:12
reviewer:2:sol:end:13:ok
manager:2:end:14:done
TRACE
assert_equal "$(observed_trace "$rec")" \
  "pick,impl1:ok,panel1:some:$members,judge1,impl2:ok,panel2:all:sol,judge2" \
  'timeout outcomes and membership stay within their Round'
echo 'PASS: mixed success/timeout and subsequent Round isolation'

# Past a probe script's last shape the fake writes clear, which is what the model reads there
# (`-` in Scenarios.lean's behaviour); Round 1 must differ, or the check proves nothing. Byte for
# byte: command substitution could see neither a missing newline nor an extra blank line.
mkdir -p "$work/probe"
probe_writes() { RLOOP_ROLE=probe RLOOP_RUN=1 RLOOP_ROUND="$1" RLOOP_FAKE_PROBE="$2" \
  RLOOP_FAKE_RECORD="$work/probe" "$fakes/claude" </dev/null 2>/dev/null; }
probe_writes 1 clear > "$work/probe/clear"
probe_writes 1 fable > "$work/probe/fable-1"
probe_writes 2 fable > "$work/probe/fable-2"
cmp -s "$work/probe/fable-1" "$work/probe/clear" && die 'Round 1 of fable writes clear'
cmp -s "$work/probe/fable-2" "$work/probe/clear" \
  || die 'Round 2 of a fable-only probe script: not the bytes of clear'
# A longer script too: a fake that repeated the script's last shape would pass the check above.
probe_writes 1 opus > "$work/probe/opus-1"
probe_writes 3 'fable|opus' > "$work/probe/late-3"
cmp -s "$work/probe/late-3" "$work/probe/clear" \
  || die 'Round 3 of a two-shape probe script: not the bytes of clear'
cmp -s "$work/probe/late-3" "$work/probe/opus-1" && die "Round 3 repeats the script's last shape"
echo "PASS: a Round past the probe script's last shape gets clear"

# Past a script's last Round the fake fails in all three roles, which is what the model reads
# there (`getD false`, `getD .none` and the `fail` judge in Scenarios.lean's behaviour). Round 1
# of the same one-Round script must differ, or a fake that failed in every Round would pass too.
rounds_dir="$work/rounds"; mkdir -p "$rounds_dir"
rounds_exit() { # rounds_exit <fake> <role> <round> [reviewer]; echoes the exit status
  local st=0
  rm -f "$rounds_dir/finished.md"
  RLOOP_ROLE="$2" RLOOP_RUN=1 RLOOP_ROUND="$3" RLOOP_REVIEWER="${4:-}" \
    RLOOP_RUN_DIR="$rounds_dir" RLOOP_FAKE_ROUNDS='impl=ok;panel=all;judge=done' \
    RLOOP_FAKE_RECORD="$rounds_dir" "$1" </dev/null >/dev/null 2>&1 || st=$?
  echo "$st"
}
rounds_case() { # rounds_case <fake>; the assertions alone, so the control can run them and fail
  assert_equal "$(rounds_exit "$1" implementer 2)" 1 'Round 2 Implementer'
  assert_equal "$(rounds_exit "$1" reviewer 2 fable)" 7 'Round 2 Reviewer'
  assert_equal "$(rounds_exit "$1" manager 2)" 1 'Round 2 judge'
  [ -e "$rounds_dir/finished.md" ] && die 'Round 2 judge wrote a Finished File'
  assert_equal "$(rounds_exit "$1" implementer 1)" 0 'Round 1 Implementer'
  assert_equal "$(rounds_exit "$1" reviewer 1 fable)" 0 'Round 1 Reviewer'
  assert_equal "$(rounds_exit "$1" manager 1)" 0 'Round 1 judge'
  [ -e "$rounds_dir/finished.md" ] || die 'Round 1 judge wrote no Finished File'
}
rounds_case "$fakes/claude"
# The control (F5): a scratch copy with the old succeeding defaults restored must be red. Each
# site must exist exactly once, or the restoration proves nothing.
for site in 'o:-fail' 'p:-none' '; judge="${judge:-fail}"'; do
  assert_equal "$(grep -cF -- "$site" "$fakes/claude")" 1 "old-defaults control: site $site"
done
sed -e 's/o:-fail/o:-ok/' -e 's/p:-none/p:-all/' -e 's/; judge="${judge:-fail}"//' \
  "$fakes/claude" > "$work/old-defaults"
chmod +x "$work/old-defaults"
cmp -s "$fakes/claude" "$work/old-defaults" && die 'old-defaults control: restored nothing'
( rounds_case "$work/old-defaults" ) 2>/dev/null \
  && die 'old-defaults control: the succeeding defaults passed the new assertions'
echo "PASS: a Round past the script's last one fails in all three roles;" \
  'the old succeeding defaults are red'
# CNF-2's executable PATH: restrict_path's skip line and its two refusals. Every name the function
# looks for resolves on this repository's development and CI hosts, so nothing else this repository
# runs reaches those three paths -- they were exercised once, by hand, by a Reviewer. Drive the
# function against a PATH built here instead. It calls exit on a refusal and overwrites the globals
# `private` and `work`, so each invocation gets a subshell and its own fresh `work`: `mkdir -p` is
# happy to reuse a directory, and a previous invocation's symlinks would satisfy the
# `executable_path_needs` refusal's `[ -e ]` for a name just taken off PATH.
thin_path() { # thin_path <dir> <names to leave out>; links every name restrict_path looks for, minus those
  local name file dir="$1" left_out=" $2 "
  mkdir -p "$dir"
  for name in cmp find bash git grep sed awk $coreutils_programs; do
    case "$left_out" in *" $name "*) continue ;; esac
    file="$(type -P "$name")" || continue
    case "$file" in /*) ;; *) file="$PWD/$file" ;; esac
    ln -s "$file" "$dir/$name"
  done
}
rp_err="$work/restrict-path-stderr"
rp_run() { # rp_run <fresh work directory> <the PATH restrict_path searches>; echoes the exit status
  local st=0
  ( work="$1"; PATH="$2"; restrict_path ) 2>"$rp_err" || st=$?
  echo "$st"
}
# The expected skip set is computed from what this host resolved, never written down: a host that
# itself lacks a coreutils program would join it and redden a check about the three names dropped
# here. Its order is the function's own iteration order, since the message appends in that loop.
rp_drops='factor nproc yes' # needed by nobody: neither cmp/find, nor in executable_path_needs, nor mkdir/ln
thin="$work/thin"; thin_path "$thin" "$rp_drops"
rp_skipped=''
for name in bash git grep sed awk $coreutils_programs; do
  [ -e "$thin/$name" ] || rp_skipped="$rp_skipped $name"
done
rp_work="$work/rp-skip"; mkdir -p "$rp_work"
assert_equal "$(rp_run "$rp_work" "$thin")" 0 'a name the host lacks: exit status'
assert_equal "$(wc -l < "$rp_err" | tr -d ' ')" 1 'a name the host lacks: CNF-2 names it once'
assert_equal "$(cat "$rp_err")" \
  "conformance: not on this host, so not on the executable's PATH:$rp_skipped" \
  'a name the host lacks: the whole skip line'
for name in $rp_drops; do
  case " $rp_skipped " in
    *" $name "*) ;; *) die "a name the host lacks: $name is not in the expected skip set" ;;
  esac
  [ -e "$rp_work/private/$name" ] && die "a name the host lacks: $name was linked anyway"
done
[ -L "$rp_work/private/sed" ] || die 'a name the host lacks: sed is not a symlink in the private directory'
case "$(readlink "$rp_work/private/sed")" in
  /*) ;; *) die 'a name the host lacks: sed links to a relative path' ;;
esac
echo 'PASS: restrict_path leaves out what the host lacks, names it once, and links the rest'

# Per name, not once for the pair: a check that only ever drops cmp says nothing about find.
for name in cmp find; do
  thin_path "$work/thin-no-$name" "$name"
  mkdir -p "$work/rp-no-$name"
  assert_equal "$(rp_run "$work/rp-no-$name" "$work/thin-no-$name")" 2 "$name missing: exit status"
  assert_equal "$(cat "$rp_err")" "conformance: $name is not on PATH and the suite needs it" \
    "$name missing: the refusal, alone"
done
echo 'PASS: restrict_path refuses, exit 2, when a tool the suite itself needs is off PATH'

# tr is in executable_path_needs, so it is also in the skip set by the time the refusal fires.
# Standard error is compared whole: it must carry the refusal and not the skip line, or the order
# of the two could invert unnoticed.
thin_path "$work/thin-no-tr" tr
mkdir -p "$work/rp-no-tr"
assert_equal "$(rp_run "$work/rp-no-tr" "$work/thin-no-tr")" 2 'a name the fakes need: exit status'
assert_equal "$(cat "$rp_err")" \
  "conformance: tr could not be linked into the executable's PATH and the fakes need it" \
  'a name the fakes need: the refusal, without the skip line'
echo 'PASS: restrict_path refuses, exit 2, when a name the fakes need cannot be linked'

# Everything below needs an executable; without one, say so in a line no CI log hides.
if [ -z "$original" ]; then
  echo 'NOT RUN: no executable given, so the fake-agent timeout, the positive scenario' \
    'replays and the rloop-bash mutants did not run'
  exit 0
fi

# Exercise real fake-agent timeouts outside the generated scenario alphabet. All Reviewers
# write starts before sleeping; timeout terminates them without normal end records.
exe="$original"
repo="$(new_repo)"; rec="$work/timeouts"
got_exit=$(RLOOP_FAKE_PICK=ok:task RLOOP_FAKE_ROUNDS='impl=ok;panel=all;judge=done' \
  RLOOP_FAKE_SLEEP_REVIEWER=30 run_rloop "$repo" "$rec" \
  --run-dir "$repo/run" --reviewer-timeout 1 --kill-after 1)
assert_equal "$got_exit" 2 'all-timeout exit'
assert_equal "$(grep -c '^reviewer:1:.*:start:' "$rec/trace")" 4 'all-timeout starts'
assert_equal "$(grep -c '^reviewer:1:.*:end:' "$rec/trace")" 0 'all-timeout ends'
assert_equal "$(observed_trace "$rec")" "pick,impl1:ok,panel1:none:$members" \
  'actual fake-agent timeouts retain complete membership without a judge'
echo "PASS: actual fake-agent timeouts, exit $got_exit, trace $(observed_trace "$rec")"
rm -rf "$repo" "$rec"

# Select existing generated scenarios, leaving every field (including expectations) intact.
select_scenario() { # select_scenario <rounds> [probe column, default the unscripted probe]
  awk -F '\t' -v rounds="$1" -v probe="${2:--}" \
    'NR==1 || ($4==rounds && $5=="-" && $6==probe && $7=="-" && !found++)' \
    "$here/scenarios.tsv" > "$work/one.tsv"
  assert_equal "$(wc -l < "$work/one.tsv" | tr -d ' ')" 2 'one selected scenario'
  IFS=$'\t' read -r id cap pick rounds interference probe seats exp_exit exp_trace \
    < <(tail -1 "$work/one.tsv")
}
positive() {
  exe="$original"
  result=$(run_scenarios "$work/one.tsv" 2> "$work/diagnostic")
  cat "$work/diagnostic"
  assert_equal "$result" '0 1' "$id complete Panel verdict"
  echo "PASS: $id complete Panel, exit $exp_exit, expected = observed: $exp_trace"
}
for cls in all some none; do
  judge=done; [ "$cls" = none ] && judge=rewrite
  select_scenario "impl=ok;panel=$cls;judge=$judge"
  positive
done

# Skip sol in both the spawn loop and the wait loop so the remaining Reviewers and Manager
# still finish normally. The failing verdict must have the correct exit and differ ONLY in
# that Round's observed membership. This calls precisely run's scenario-comparison path.
# Both loops are in do_round; the probe's verdict loop, outside it, is left alone.
assert_equal "$(sed -n '/^do_round() {/,/^}/p' "$original" \
  | grep -c '^  for rv in fable opus astra sol; do$')" 2 'rloop-bash mutation sites'
for skipped_round in 1 2; do
  sed "/^do_round() {/,/^}/{
/^  for rv in fable opus astra sol; do$/a\\
    if [ \"\$r\" = $skipped_round ] \&\& [ \"\$rv\" = sol ]; then continue; fi
}" \
    "$original" > "$work/omit-sol"
  chmod +x "$work/omit-sol"
  rounds='impl=ok;panel=all;judge=done'
  [ "$skipped_round" = 2 ] && rounds="impl=ok;panel=all;judge=rewrite|$rounds"
  select_scenario "$rounds"
  positive
  exe="$work/omit-sol"
  result=$(run_scenarios "$work/one.tsv" 2> "$work/diagnostic")
  cat "$work/diagnostic"
  assert_equal "$result" '1 1' "$id omitted-Reviewer verdict"
  without_sol="panel$skipped_round:all:astra+fable+opus"
  observed=${exp_trace/"panel$skipped_round:all:$members"/"$without_sol"}
  assert_equal "$(cat "$work/diagnostic")" \
    "        $id: expected exit $exp_exit trace $exp_trace; got exit $exp_exit trace $observed" \
    "$id isolated membership mismatch"
  echo "PASS: $id negative control rejected (1 of 1 scenarios differ);" \
    "skipped sol in Round $skipped_round"
done

# The probe scripts (RUN-21, RUN-15): every generated line carrying one probe column passes
# against the executable and goes red against a mutant that gets that case wrong. Lines are
# selected, never edited; each mutation site must exist exactly once, or the mutant proves
# nothing.
probe_case() { # probe_case <probe column> <label> <mutation site, fixed string> <sed expression>
  local probe="$1" label="$2" site="$3" expr="$4" n result
  awk -F '\t' -v p="$probe" 'NR==1 || $6==p' "$here/scenarios.tsv" > "$work/probe.tsv"
  n=$(( $(wc -l < "$work/probe.tsv") - 1 ))
  [ "$n" -ge 1 ] || die "$label: no generated line has probe $probe"
  exe="$original"
  assert_equal "$(run_scenarios "$work/probe.tsv" 2>/dev/null)" "0 $n" "$label, unmutated"
  assert_equal "$(grep -cF -- "$site" "$original")" 1 "$label: mutation site"
  sed "$expr" "$original" > "$work/mutant"; chmod +x "$work/mutant"
  cmp -s "$original" "$work/mutant" && die "$label: the mutation changed nothing"
  exe="$work/mutant"
  result=$(run_scenarios "$work/probe.tsv" 2> "$work/diagnostic")
  cat "$work/diagnostic"
  [ "${result%% *}" -ge 1 ] || die "$label: the mutant passed all $n lines with probe $probe"
  echo "PASS: $label: the mutant fails ${result%% *} of $n lines with probe $probe"
}
probe_case opus 'Opus unavailable; mutant: the table has no Opus row' \
  ' opus) fam=Opus ;;' 's/ opus) fam=Opus ;;//'
probe_case fable 'Fable unavailable; mutant: the table has no Fable row' \
  ' fable) fam=Fable ;;' 's/ fable) fam=Fable ;;//'
probe_case both 'all four down; mutant: a Reviewer not run is not counted down' \
  'pids+=("")' '/pids+=("")/{n;/failed=\$((failed + 1))/d}'
probe_case 'fable|clear' 'Fable re-admitted in Round 2; mutant: verdicts remembered across Rounds' \
  "  unavail=' '" "s/^  unavail=' '\$/  unavail=\"\${unavail:- }\"/"
probe_case fail 'a probe that fails; mutant: its exit status ignored' \
  'if [ "$pst" = 0 ] && [ -n "$fam" ]' 's/if \[ "\$pst" = 0 \] && \[ -n "\$fam" \]/if [ -n "$fam" ]/'
probe_case loose 'a probe that does not parse; mutant: the match not anchored' \
  'case $line in "Current week' 's/case \$line in "Current week/case $line in *"Current week/'
probe_case unlisted 'families outside the table; mutant: the codex Reviewers given families' \
  "*) fam='' ;;" "s/ \*) fam='' ;;/ astra) fam=Astra ;; sol) fam=Sol ;; *) fam='' ;;/"
probe_case unlisted 'families outside the table; mutant: any family name matches' \
  '"Current week ($fam): 100% used"*)' 's/"Current week (\$fam): 100% used"\*)/"Current week ("*"): 100% used"*)/'

# A Round the probe left a Reviewer out of, whose called Reviewers did not agree (RUN-15): the
# one that succeeded is kept and the judge is reached. The mutant reads a Reviewer not run beside
# a called one that failed as an all-down Panel, so it exits 2 with no judge; the diagnostic must
# be that difference and nothing else, or the control is not the one it names. The zero-survivor
# abort is the single site, and the mutant leaves it standing for the Panels it already aborts.
select_scenario 'impl=ok;panel=some;judge=done' fable
positive
site='[ "$failed" -lt 4 ]'
assert_equal "$(grep -cF -- "$site" "$original")" 1 'uncalled beside a failure: mutation site'
sed 's/\[ "\$failed" -lt 4 \]/& \&\& { unrun=0; for u in "${pids[@]}"; do [ -n "$u" ] || unrun=$((unrun + 1)); done; [ "$unrun" = 0 ] || [ "$unrun" = "$failed" ]; }/' \
  "$original" > "$work/uncalled-with-failure"
chmod +x "$work/uncalled-with-failure"
cmp -s "$original" "$work/uncalled-with-failure" \
  && die 'uncalled beside a failure: the mutation changed nothing'
exe="$work/uncalled-with-failure"
result=$(run_scenarios "$work/one.tsv" 2> "$work/diagnostic")
cat "$work/diagnostic"
assert_equal "$result" '1 1' "$id uncalled-beside-a-failure verdict"
assert_equal "$(cat "$work/diagnostic")" \
  "        $id: expected exit $exp_exit trace $exp_trace; got exit 2 trace ${exp_trace%,judge1}" \
  "$id withheld judge, unchanged membership"
echo "PASS: $id negative control rejected (1 of 1 scenarios differ);" \
  'the mutant keeps the survivor and withholds the judge'
